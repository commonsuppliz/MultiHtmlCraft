<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<WarningLevel>0</WarningLevel>

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">

  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiHtmlCraft\MultiHtmlCraft.Core\MultiHtmlCraft.Core.csproj" />
    <ProjectReference Include="..\MultiHtmlCraft\NilJsProcessor\NilJsProcessor.csproj" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="NiL.JS" Version="2.6.1700" />
	</ItemGroup>
	<PropertyGroup>
		<NoWarn>$(NoWarn);SYSLIB0013; NU1510</NoWarn>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
	  <Folder Include="js\" />
	</ItemGroup>

</Project>
