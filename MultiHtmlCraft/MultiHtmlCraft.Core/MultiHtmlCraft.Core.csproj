<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <TargetFrameworks>net9.0;net9.0-windows</TargetFrameworks>

      <TargetFrameworkVersion>9.0</TargetFrameworkVersion>
      <ImplicitUsings>disable</ImplicitUsings>
      <Nullable>enable</Nullable>
      <AssemblyName>MultiHtmlCraft.Core</AssemblyName>
      <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
      <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
      <LangVersion>11.0</LangVersion>
      <WarningLevel>0</WarningLevel>
      <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <PropertyGroup>
       <AssemblyVersion>2.1.1</AssemblyVersion>
       <FileVersion>2.1.1</FileVersion>
       <Version>2.1.1</Version>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Avalonia.Skia" Version="11.3.11" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ManagedBass.ZipStream" Version="0.2.2" />
    <PackageReference Include="NLog" Version="5.5.0" />
    <PackageReference Include="NTextCat" Version="0.3.65" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <PackageReference Include="Svg" Version="3.4.7" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClearScriptProcessor\ClearScriptProcessor.csproj" />
    <ProjectReference Include="..\Interfaces\MultiHtmlCraft.Interfaces.csproj" />
    <ProjectReference Include="..\NilJsProcessor\NilJsProcessor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
    <!-- Copy font assets to output so fonts.json paths resolve at runtime -->
    <Content Include="Assets\Fonts\**\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\**\*.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Embed NTextCat profile into assembly so GetManifestResourceNames can find it -->
    <EmbeddedResource Include="Resource\Core14.profile.xml">
      <LogicalName>MultiHtmlCraft.Core.Resource.Core14.profile.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="CHtmlImage.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="fonts.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="lib\bass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="lib\ManagedBass.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="lib\ManagedBass.Flac.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Note: Resource files are included by default as EmbeddedResource; no explicit entry required. -->

  <!-- Windows-specific settings applied when targeting net9.0-windows -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0-windows' ">
    <DefineConstants>WINDOWS;WINFORMS</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Platform define constants for other TFMs if needed -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <!-- No special settings for cross-platform TFM -->
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0' and '$(RuntimeIdentifier)' == 'linux-arm64' ">
    <DefineConstants>LINUX;LINUX_ARM</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0' and '$(RuntimeIdentifier)' == 'osx-arm64' ">
    <DefineConstants>MACOS;MACOS_ARM</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0' and '$(RuntimeIdentifier)' == 'osx-x64' ">
    <DefineConstants>MACOS;MACOS_X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net9.0' and '$(RuntimeIdentifier)' == 'linux-x64' ">
    <DefineConstants>LINUX;LINUX_X64</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);SYSLIB0013</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
