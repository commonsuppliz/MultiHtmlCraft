<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net9.0</TargetFramework>
	  <ImplicitUsings>disable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <AssemblyName>MultiHtmlCraft.Core</AssemblyName>
	  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	  <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	  <LangVersion>8.0</LangVersion>
	  <WarningLevel>0</WarningLevel>
	  <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="NLog" Version="5.5.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClearScriptProcessor\ClearScriptProcessor.csproj" />
    <ProjectReference Include="..\Interfaces\MultiHtmlCraft.Interfaces.csproj" />
    <ProjectReference Include="..\NilJsProcessor\NilJsProcessor.csproj" />
    <ProjectReference Include="..\PythonProssesor\PythonProcessor.csproj" />
  </ItemGroup>

	<PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
		<DefineConstants>LINUX;MACOS</DefineConstants>
	</PropertyGroup>
</Project>
