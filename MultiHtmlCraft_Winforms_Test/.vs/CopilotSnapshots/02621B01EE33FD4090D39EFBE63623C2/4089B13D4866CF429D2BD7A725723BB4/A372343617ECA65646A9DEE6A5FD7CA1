using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace MultiHtmlCraft.Interfaces
{
    public interface ICHtmlWorker
    {   /// <summary>
        /// Base URL for the worker window
        /// </summary>
        string baseUrl { get; set; }
        /// <summary>
        /// Event triggered when an instance of the worker window is created
        /// </summary>
        event EventHandler? InstanceCreated;
        /// <summary>
        /// Navigate to a specified URL
        /// </summary>
        /// <param name="url">The URL to navigate to</param>
        void NavigateToUrl(string url);
        
        /// <summary>
        /// Get the current URL of the worker window
        /// </summary>
        /// <returns>The current URL</returns>
        string GetCurrentUrl();
    }
}
