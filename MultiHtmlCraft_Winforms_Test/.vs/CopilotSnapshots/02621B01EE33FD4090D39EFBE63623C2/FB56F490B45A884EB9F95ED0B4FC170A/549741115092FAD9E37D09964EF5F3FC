        /// <param name="args"></param>
        public CHtmlSharedWorkerWindow(params string[] args)
    : base(null, true, IMultiversalWindowType.SharedWorkerWindow, args)
        {
            if (InstanceCreated != null)
            {
                InstanceCreated?.Invoke(this, EventArgs.Empty);
            }
            var _curUrl = base.___getCurrentUrl();
        }
        #region IDyamicMetaObjectProvider support to get and set properties
        public DynamicMetaObject GetMetaObject(System.Linq.Expressions.Expression parameter)
        {
            return new CHtmlDynamicMetaObject<CHtmlDocument>(parameter, this);
        }
        public object GetDynamicMember(string name)
        {
            object objValue = null;
            //this.___properties.TryGetValue(name, out objValue);
