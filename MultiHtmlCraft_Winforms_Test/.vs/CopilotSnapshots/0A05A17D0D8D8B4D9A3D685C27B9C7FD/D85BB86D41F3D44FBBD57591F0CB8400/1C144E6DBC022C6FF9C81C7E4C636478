        public void initScriptEngine()
        {
            lock (_initLock)
            {
                if (_isInitCompleted)
                    return;

                try
                {
                    System.Diagnostics.Debug.WriteLine($"NilJs init called {System.Threading.Thread.CurrentThread}");

                    globalContext = new GlobalContext
                    {
                        GlobalObjectsAssignMode = GlobalObjectsAssignMode.Allow
                    };

                    context = new NiL.JS.Core.Context(globalContext);
                    processor = new NilJsProcessor();
                    processor.multiversalscope = this;

                    this.setHostWindowToContext(context, multiwindow);
                    var w = getMultiversalWindow();
                    if (w != null)
                    {
                        EnsureWindowGlobal(context, w);
                        try {
                            context.Eval(@"(function(win){ if(!win) return; var props=['navigator','history','location']; for(var i=0;i<props.length;i++){ var n=props[i]; try{ var v=win[n]; } catch(e){ if(e&&e.message&&e.message.indexOf('NotImplemented')>=0){ try{ win[n]={}; }catch(_){} } } } })(typeof window!=='undefined'?window: (typeof globalThis!=='undefined'?globalThis:null));");
                        } catch { }
                    }

                    createStandardObjects();
                    createWindowFunctionSortedList();

                    // Define lightweight constructors that delegate to window.___createObject
                    try
                    {
                        defineHostlessConstructor("XMLHttpRequest");
                        defineHostlessConstructor("Image");
                        defineHostlessConstructor("DOMParser");
                    }
                    catch (Exception exCtor)
                    {
                        System.Diagnostics.Debug.WriteLine("NilJs: hostless ctor error " + exCtor.Message);
                    }

                    ___InitGlobalAliases(globalContext);
                    _isInitCompleted = true;
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"NilJS initScriptEngine failed: {ex.Message}");
                    try
                    {
                        context = new NiL.JS.Core.Context();
                        processor = new NilJsProcessor();
                        processor.multiversalscope = this;
                        _isInitCompleted = true;
                        createBasicStandardObjects();
                        createWindowFunctionSortedList();
                        try
                        {
                            defineHostlessConstructor("XMLHttpRequest");
                            defineHostlessConstructor("Image");
                            defineHostlessConstructor("DOMParser");
                        }
                        catch { }
                    }
                    catch (Exception fallbackEx)
                    {
                        System.Diagnostics.Debug.WriteLine($"NilJS fallback init failed: {fallbackEx.Message}");
                        throw new InvalidOperationException("Failed to initialize NiL.JS engine", fallbackEx);
                    }
                }
            }
        }

        // New helper: creates JS constructor that forwards to window.___createObject(jsName,...)
        private void defineHostlessConstructor(string jsName)
        {
            if (context == null) return;
            ensureCreateObjectBridge();
            var script = @"(function(){function __JSNAME__(){try{if(typeof window!=='undefined'&&typeof window.___createObject==='function'){var arr=['__JSNAME__'];for(var i=0;i<arguments.length;i++)arr.push(arguments[i]);var r0=window.___createObject.apply(window,arr);if(r0!==undefined&&r0!==null)return r0;}}catch(e){}return {};}(typeof globalThis!=='undefined'?globalThis:this)['__JSNAME__']=__JSNAME__})();";
            script = script.Replace("__JSNAME__", jsName);
            context.Eval(script);
            try
            {
                var funcVal = context.Eval($"(typeof globalThis!=='undefined' && globalThis['{jsName}']) || (typeof window!=='undefined' && window['{jsName}']) || undefined");
                if (funcVal != null && funcVal.ValueType == JSValueType.Function)
                {
                    context.DefineVariable(jsName).Assign(funcVal);
                }
            }
            catch { }
        }
        private void ensureCreateObjectBridge()
        {
            // すでに __host_createObject が定義済みなら何もしない
            var existing = context.GetVariable("__host_createObject");
            if (existing != null && existing.ValueType == JSValueType.Function)
                return;

            // __host_createObject を定義
            var hostCreate = new ExternalFunction((JSValue thisArg, Arguments args) =>
            {
                try
                {
                    if (multiwindow == null || args == null || args.Length == 0)
                        return JSValue.Undefined;

                    var typeName = Convert.ToString(args[0].Value);
                    var ctorArgsCount = System.Math.Max(0, args.Length - 1); // ← System.Math に固定
                    var ctorArgs = new object[ctorArgsCount];
                    for (int i = 0; i < ctorArgsCount; i++)
                        ctorArgs[i] = args[i + 1]?.Value;

                    var inst = multiwindow.___createObject(typeName, ctorArgs);
                    if (inst == null && _objectFactory != null)
                        inst = _objectFactory(typeName, ctorArgs);

                    return inst == null ? JSValue.Undefined : JSValue.Marshal(inst);
                }
                catch (Exception ex)
                {
#if DEBUG
                    System.Diagnostics.Debug.WriteLine($"__host_createObject error: {ex}");
#endif
                    return JSValue.Undefined;
                }
            });
            context.DefineVariable("__host_createObject").Assign(hostCreate);

            var initScript = @"
                (function() {
                  if (typeof window !== 'undefined' && typeof window.___createObject !== 'function') {
                    window.___createObject = function(typeName) {
                      return __host_createObject.apply(window, arguments);
                    };
                  }
                })();";
            context.Eval(initScript);
        }



        public void defineConstructor(Type type, string jsName)
        {

            ensureCreateObjectBridge();

            var defaultTagByJsName = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                ["HTMLElement"] = "div",
                ["Element"] = "div",
                ["HTMLDivElement"] = "div",
                ["HTMLInputElement"] = "input",
                ["HTMLButtonElement"] = "button",
                ["HTMLIFrameElement"] = "iframe",
                ["SVGElement"] = "svg",
                ["Image"] = "img",
                ["XMLHttpRequest"] = "xmlhttprequest"
            };

            // C# 側ホストコンストラクタ：.NETでの実体生成のみを担当
            var hostCtorName = $"__host_ctor_{jsName}";
            var hostCtor = new ExternalFunction((JSValue thisArg, Arguments args) =>
            {
                try
                {
                    // JS -> .NET 引数変換
                    var netArgs = new object[args.Length];
                    for (int i = 0; i < args.Length; i++)
                        netArgs[i] = args[i]?.Value;

                    object? instance = null;

                    // 1) MultiversalWindow 側のファクトリ
                    if (multiwindow != null)
                        instance = multiwindow.___createObject(jsName, netArgs);

                    // 2) 注入ファクトリ
                    if (instance == null && _objectFactory != null)
                        instance = _objectFactory(jsName, netArgs);

                    // 3) 型の既定コンストラクタ
                    if (instance == null)
                        instance = Activator.CreateInstance(type);

                    if (instance != null)
                    {
                        // プロパティ補助 (tagName / Image.src)
                        try
                        {
                            var tagProp = instance.GetType().GetProperty("tagName",
                                BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
                            if (tagProp?.CanWrite == true)
                            {
                                if (args.Length >= 1 && args[0]?.Value != null)
                                    tagProp.SetValue(instance, Convert.ToString(args[0].Value));
                                else if (defaultTagByJsName.TryGetValue(jsName, out var fallbackTag))
                                    tagProp.SetValue(instance, fallbackTag);
                            }

                            if (jsName.Equals("Image", StringComparison.OrdinalIgnoreCase)
                                && args.Length >= 1 && args[0]?.Value != null)
                            {
                                var srcProp = instance.GetType().GetProperty("src",
                                    BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
                                if (srcProp?.CanWrite == true)
                                    srcProp.SetValue(instance, Convert.ToString(args[0].Value));
                            }
                        }
                        catch (Exception setPropEx)
                        {
#if DEBUG
                            System.Diagnostics.Debug.WriteLine($"defineConstructor('[jsName]') property assign failed: {setPropEx}");
#endif
                        }
                    }

                    return JSValue.Marshal(instance);
                }
                catch (Exception ex)
                {
#if DEBUG
                    System.Diagnostics.Debug.WriteLine($"defineConstructor('[jsName]') error: {ex}");
#endif
                    return JSValue.Undefined;
                }
            });
            context.DefineVariable(hostCtorName).Assign(hostCtor);

            // JS 側ラッパー
            var script = @"
(function() {

  function __JSNAME__() {
    try {

      if (typeof window !== 'undefined' && typeof window.___createObject === 'function') {
        var arr = ['__JSNAME__'];
        for (var i = 0; i < arguments.length; i++) arr.push(arguments[i]);
        var r0 = window.___createObject.apply(window, arr);
        if (r0 !== undefined && r0 !== null) return r0;
      }
    } catch (e) {}
    var r = __HOSTCTOR__.apply(this, arguments);
    return (r === undefined || r === null) ? this : r;
  }

  (typeof globalThis !== 'undefined' ? globalThis : this)['__JSNAME__'] = __JSNAME__;
})();";
            script = script.Replace("__JSNAME__", jsName).Replace("__HOSTCTOR__", hostCtorName);
            context.Eval(script);


            try
            {
                var funcVal = context.Eval($"(typeof globalThis!=='undefined' && globalThis['{jsName}']) || (typeof window!=='undefined' && window['{jsName}']) || undefined");
                if (funcVal != null && funcVal.ValueType == JSValueType.Function)
                {
                    context.DefineVariable(jsName).Assign(funcVal);
                }
            }
            catch (Exception ex)
            {
#if DEBUG
                System.Diagnostics.Debug.WriteLine($"defineConstructor: binding var {jsName} failed: {ex}");
#endif
            }
        }
