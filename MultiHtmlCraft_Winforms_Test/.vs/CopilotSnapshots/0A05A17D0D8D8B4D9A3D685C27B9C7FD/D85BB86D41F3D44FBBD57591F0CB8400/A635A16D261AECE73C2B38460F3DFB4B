    public class NilJsScope : IMultiversalScriptScope
    {
        private IMultiversalWindow multiwindow = null;
        public Context context = null;
        public GlobalContext globalContext = null;
        private bool _isInitCompleted = false;
        private IMultiversalScriptProcessor processor = null;
        private readonly object _initLock = new object();
        private Func<string, object[], object>? _objectFactory;
        private JSValue _cachedWindowJsValue;
        private IMultiversalWindow _cachedWindowSource;
        private string _scopeName = "NilJsScope";
        private IMultiversalWindowType _windowType = IMultiversalWindowType.Unknown;
        private int _timeout = 0;
        // script mime list
        private static readonly List<string> _invokeNames = new List<string>{"text/javascript","javascript","application/javascript"};
        public NilJsScope(IMultiversalWindow multi){ multiwindow = multi; }
        public NilJsScope(){ }
        public void setObjectFactory(Func<string, object[], object> factory){ _objectFactory = factory; }
        public string getMultivasalScopeName()=> _scopeName;
        public IMultiversalScriptProcessor getMultiversalScriptProcessor(){ processor.multiversalscope = this; return processor; }
