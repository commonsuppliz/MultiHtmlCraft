        public void createStandardObjects()
        {
            try
            {
                // Define globalThis/self as the real JS global object rather than a marshaled host object
                try
                {
                    context.Eval(@"(function(g){ try{ if (typeof g.globalThis==='undefined') g.globalThis = g; }catch(_){ } try{ if (typeof g.self==='undefined') g.self = g; }catch(_){ } })(typeof globalThis!=='undefined'?globalThis:(typeof window!=='undefined'?window:{}));");
                }
                catch { }

                // 基本的なタイマー関数を定義
                createTimerFunctions();

                // その他の関数を定義
                createOtherStandardFunctions();

            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"createStandardObjects failed: {ex.Message}");
                // フォールバック: 基本的な関数のみ定義
                createBasicStandardObjects();
            }
        }

        private void createBasicStandardObjects()
        {
            try
            {
                // 最低限必要なタイマー関数のみ定義
                context.DefineVariable("clearTimeout").Assign(JSValue.Marshal(new Action<int>((id) =>
                {
                    var args = new object[] { id };
                    multiwindow?.clearTimeout(args);
                })));

                context.DefineVariable("clearInterval").Assign(JSValue.Marshal(new Action<int>((id) =>
                {
                    var args = new object[] { id };
                    multiwindow?.clearInterval(args);
                })));

                context.DefineVariable("setTimeout").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((callback, delay) =>
                {
                    if (multiwindow == null) return JSValue.Undefined;
                    var args = new object[] { callback.Value, delay.Value };
                    var result = multiwindow.setTimeout(args);
                    return JSValue.Marshal(result);
                })));

                context.DefineVariable("setInterval").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((callback, interval) =>
                {
                    if (multiwindow == null) return JSValue.Undefined;
                    var args = new object[] { callback.Value, interval.Value };
                    var result = multiwindow.setInterval(args);
                    return JSValue.Marshal(result);
                })));
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"createBasicStandardObjects failed: {ex.Message}");
            }
        }

        private void createTimerFunctions()
        {
            context.DefineVariable("setTimeout").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((callback, delay) =>
            {
                var args = new object[] { callback.Value, delay.Value };
                var result = multiwindow.setTimeout(args);
                return JSValue.Marshal(result);
            })));

            context.DefineVariable("setInterval").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((callback, interval) =>
            {
                var args = new object[] { callback.Value, interval.Value };
                var result = multiwindow.setInterval(args);
                return JSValue.Marshal(result);
            })));

            context.DefineVariable("clearTimeout").Assign(JSValue.Marshal(new Action<int>((id) =>
            {
                var args = new object[] { id };
                multiwindow.clearTimeout(args);
            })));

            context.DefineVariable("clearInterval").Assign(JSValue.Marshal(new Action<int>((id) =>
            {
                var args = new object[] { id };
                multiwindow.clearInterval(args);
            })));
        }

        private void createOtherStandardFunctions()
        {
            // touch/pointer event name stubs
            try
            {
                var touchEvents = new string[] {
                    "ontouchstart", "ontouchend", "ontouchmove", "ontouchcancel",
                    "ontouchenter", "ontouchleave", "onpointerdown", "onpointerup",
                    "onpointermove", "onpointerover", "onpointerout", "onpointerenter",
                    "onpointerleave", "onpointercancel"
                };
                foreach (var eventName in touchEvents)
                {
                    try { context.DefineVariable(eventName).Assign(JSValue.Null); } catch { }
                }
            }
            catch { }

            // === REDEFINE EVENT FUNCTIONS AS PURE JS ExternalFunction ===
            var addEvFunc = new ExternalFunction((thisArg, args) =>
            {
                try
                {
                    var type = args.Length > 0 ? args[0].Value?.ToString() : null;
                    var listener = args.Length > 1 ? args[1] : null;
                    var useCapture = args.Length > 2 ? args[2] : null; // optional
                    if (!string.IsNullOrEmpty(type)) multiwindow?.addEventListener(type, listener?.Value, useCapture?.Value);
                }
                catch { }
                return JSValue.Undefined;
            });
            context.DefineVariable("addEventListener").Assign(addEvFunc);

            var removeEvFunc = new ExternalFunction((thisArg, args) =>
            {
                try
                {
                    var type = args.Length > 0 ? args[0].Value?.ToString() : null;
                    var listener = args.Length > 1 ? args[1] : null;
                    var useCapture = args.Length > 2 ? args[2] : null;
                    if (!string.IsNullOrEmpty(type)) multiwindow?.removeEventListener(type, listener?.Value, useCapture?.Value);
                }
                catch { }
                return JSValue.Undefined;
            });
            context.DefineVariable("removeEventListener").Assign(removeEvFunc);

            var dispatchEvFunc = new ExternalFunction((thisArg, args) =>
            {
                try { var evtObj = args.Length > 0 ? args[0].Value : null; multiwindow?.dispatchEvent(evtObj); } catch { }
                return JSValue.Undefined;
            });
            context.DefineVariable("dispatchEvent").Assign(dispatchEvFunc);

            // Sync to window object immediately (unconditional)
            try
            {
                context.Eval(@"(function(){try{var w=(typeof window!=='undefined')?window:(typeof globalThis!=='undefined'?globalThis:this);if(w){w.addEventListener=addEventListener;w.removeEventListener=removeEventListener;w.dispatchEvent=dispatchEvent;}}catch(e){}})();");
            }
            catch { }

            // Animation (rebind using ExternalFunction to keep JSValue intact)
            context.DefineVariable("requestAnimationFrame").Assign(new ExternalFunction((thisArg, args) =>
            {
                try
                {
                    var cb = (args != null && args.Length > 0) ? args[0] : null; // keep JSValue
                    var result = multiwindow.requestAnimationFrame(cb != null ? new object[] { cb } : System.Array.Empty<object>());
                    return JSValue.Marshal(result);
                }
                catch { return JSValue.Marshal(-1d); }
            }));
            context.DefineVariable("cancelAnimationFrame").Assign(new ExternalFunction((thisArg, args) =>
            {
                try
                {
                    if (args != null && args.Length > 0)
                    {
                        var idVal = args[0];
                        multiwindow.cancelAnimationFrame(new object[] { idVal });
                    }
                }
                catch { }
                return JSValue.Undefined;
            }));

            // Dialogs
            context.DefineVariable("alert").Assign(JSValue.Marshal(new Func<JSValue, JSValue>((message) => { multiwindow.alert(new object[] { message.Value }); return JSValue.Undefined; })));
            context.DefineVariable("confirm").Assign(JSValue.Marshal(new Func<JSValue, JSValue>((message) => JSValue.Marshal(multiwindow.confirm(new object[] { message.Value })) )));
            context.DefineVariable("prompt").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((message, def) => JSValue.Marshal(multiwindow.prompt(new object[] { message.Value, def?.Value })) )));

            // Window ops (subset kept; others unchanged)...
            context.DefineVariable("open").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue, JSValue>((url, target, features) =>
            {
                var arr = new object[] { url?.Value, target?.Value, features?.Value }.Where(a => a != null).ToArray();
                return JSValue.Marshal(multiwindow.open(arr));
            })));
            context.DefineVariable("close").Assign(JSValue.Marshal(new Func<JSValue>(() => { multiwindow.close(System.Array.Empty<object>()); return JSValue.Undefined; })));
            context.DefineVariable("focus").Assign(JSValue.Marshal(new Func<JSValue>(() => { multiwindow.focus(System.Array.Empty<object>()); return JSValue.Undefined; })));
            context.DefineVariable("scroll").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((x, y) => { multiwindow.scroll(new object[] { x?.Value, y?.Value }); return JSValue.Undefined; })));
            context.DefineVariable("scrollTo").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((x, y) => { multiwindow.scrollTo(new object[] { x?.Value, y?.Value }); return JSValue.Undefined; })));
            context.DefineVariable("scrollBy").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((x, y) => { multiwindow.scrollBy(new object[] { x?.Value, y?.Value }); return JSValue.Undefined; })));
            context.DefineVariable("moveTo").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((x, y) => { multiwindow.moveTo(new object[] { x?.Value, y?.Value }); return JSValue.Undefined; })));
            context.DefineVariable("moveBy").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((x, y) => { multiwindow.moveBy(new object[] { x?.Value, y?.Value }); return JSValue.Undefined; })));
            context.DefineVariable("resizeTo").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((w, h) => { multiwindow.resizeTo(new object[] { w?.Value, h?.Value }); return JSValue.Undefined; })));
            context.DefineVariable("resizeBy").Assign(JSValue.Marshal(new Func<JSValue, JSValue, JSValue>((w, h) => { multiwindow.resizeBy(new object[] { w?.Value, h?.Value }); return JSValue.Undefined; })));


            // Encoding/Decoding (unchanged logic condensed)
            context.DefineVariable("encodeURI").Assign(JSValue.Marshal(new Func<JSValue, JSValue>((v) => JSValue.Marshal(multiwindow.encodeURI(new object[] { v.Value })))));

