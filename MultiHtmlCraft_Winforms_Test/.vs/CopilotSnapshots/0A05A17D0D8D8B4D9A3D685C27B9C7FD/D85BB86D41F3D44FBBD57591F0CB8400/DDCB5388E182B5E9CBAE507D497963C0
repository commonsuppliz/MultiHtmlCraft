        private void setHostWindowToContext(Context ctx, IMultiversalWindow sourceWindow)
        {
            if (_cachedWindowJsValue == null || !object.ReferenceEquals(_cachedWindowSource, multiwindow))
            {
                _cachedWindowJsValue = JSValue.Marshal(multiwindow);
                _cachedWindowSource = multiwindow;
            }

            try
            {
                if (globalContext != null)
                {
                    globalContext.DefineVariable("__hostWindow").Assign(_cachedWindowJsValue);
                }
                if (context != null)
                {
                    context.DefineVariable("__hostWindow").Assign(_cachedWindowJsValue);

                    var bridge = @"
(function(){
  try {
    if (typeof __hostWindow !== 'undefined' && __hostWindow) {
      var root = (function(){ return this; })();
      var win = (root.window && root.window.__unifiedWindowMarker) ? root.window : {};
      try { Object.defineProperty(win,'__unifiedWindowMarker',{ value:true, configurable:false }); } catch(_){}
      function map(name){
        try {
          Object.defineProperty(win, name, {
            configurable:true,
            enumerable:true,
            get:function(){ try { return __hostWindow[name]; } catch(_){ return undefined; } },
            set:function(v){ try { __hostWindow[name] = v; } catch(_){ } }
          });
        } catch(_){ }
      }
      var names = [
        'document','console','navigator','location','history',
        'setTimeout','clearTimeout','setInterval','clearInterval',
        'alert','confirm','prompt','open','postMessage'
      ];
      for (var i=0;i<names.length;i++) map(names[i]);
      try { Object.defineProperty(win,'innerWidth',{ configurable:true, enumerable:true, get:function(){ try{ return __hostWindow.___getinnerWidth ? __hostWindow.___getinnerWidth() : 0; }catch(_){ return 0; } } }); } catch(_){ }
      try { Object.defineProperty(win,'innerHeight',{ configurable:true, enumerable:true, get:function(){ try{ return __hostWindow.___getinnerHeight ? __hostWindow.___getinnerHeight() : 0; }catch(_){ return 0; } } }); } catch(_){ }
      try { win.toString = function(){ return '[object Window]'; }; } catch(_){ }
      try { win.__hostWindow = __hostWindow; } catch(_){ }
      try { root.window = win; } catch(_){ }
      try { root.self = win; } catch(_){ }
      try { root.globalThis = win; } catch(_){ }
    }
  } catch(_){ }
})();";
                    try { context.Eval(bridge); } catch { }

                    // === 追加: on* イベントプロパティをホスト側 ___set/get_onfunction_property に委譲 ===
                    try
                    {
                        var list = createWindowFunctionSortedList(); // 既存メソッド利用
                        var sb = new System.Text.StringBuilder();
                        sb.Append("(function(){try{var w=(typeof window!=='undefined')?window:(function(){return this;})();");
                        sb.Append("if(w && typeof __hostWindow!=='undefined' && __hostWindow){");
                        sb.Append("function bindEvt(n){try{Object.defineProperty(w,n,{configurable:true,enumerable:true,");
                        sb.Append("get:function(){try{return __hostWindow.___get_onfunction_property(n);}catch(_){return undefined;}},");
                        sb.Append("set:function(v){try{__hostWindow.___set_onfunction_property(n,v);}catch(_){}}});}catch(_){}}");
                        foreach (var kv in list)
                        {
                            sb.Append("bindEvt('").Append(kv.Key).Append("');");
                        }
                        // 念のため window.onload がない場合確実に定義
                        sb.Append("if(!('onload' in w)) bindEvt('onload');");
                        sb.Append("}}catch(_){}})();");
                        context.Eval(sb.ToString());
                    }
                    catch { }

                    // Patch: ensure animation frame functions ...
                    try {
                        context.Eval(@"(function(){try{var w=(typeof window!=='undefined')?window:(typeof globalThis!=='undefined'?globalThis:this);if(w&&typeof requestAnimationFrame==='function'){w.requestAnimationFrame=requestAnimationFrame;}if(w&&typeof cancelAnimationFrame==='function'){w.cancelAnimationFrame=cancelAnimationFrame;}}catch(e){}})();");
                    } catch { }
                }
            }
            catch { }

            // touch/pointer globals as identifiers only
            try
            {
                var touchEvents = new string[] {
                    "ontouchstart", "ontouchend", "ontouchmove", "ontouchcancel",
                    "ontouchenter", "ontouchleave"
                };
                foreach (var eventName in touchEvents)
                {
                    try { context.DefineVariable(eventName).Assign(JSValue.Null); } catch { }
                }
                var pointerEvents = new string[] {
                    "onpointerdown", "onpointerup", "onpointermove", "onpointerover",
                    "onpointerout", "onpointerenter", "onpointerleave", "onpointercancel"
                };
                foreach (var eventName in pointerEvents)
                {
                    try { context.DefineVariable(eventName).Assign(JSValue.Null); } catch { }
                }
            }
            catch { }
        }
