        public void initScriptEngine()
        {
            lock (_initLock)
            {
                if (_isInitCompleted)
                    return;

                try
                {
                    System.Diagnostics.Debug.WriteLine($"NilJs init called {System.Threading.Thread.CurrentThread}");

                    globalContext = new GlobalContext
                    {
                        GlobalObjectsAssignMode = GlobalObjectsAssignMode.Allow
                    };

                    context = new NiL.JS.Core.Context(globalContext);
                    processor = new NilJsProcessor();
                    processor.multiversalscope = this;

                    // --- CHANGED ORDER: first create window bridge so window exists ---
                    this.setHostWindowToContext(context, multiwindow);
                    var w = getMultiversalWindow();
                    if (w != null)
                    {
                        EnsureWindowGlobal(context, w);
                        try {
                            context.Eval(@"(function(win){ if(!win) return; var props=['navigator','history','location']; for(var i=0;i<props.length;i++){ var n=props[i]; try{ var v=win[n]; } catch(e){ if(e&&e.message&&e.message.indexOf('NotImplemented')>=0){ try{ win[n]={}; }catch(_){} } } } })(typeof window!=='undefined'?window: (typeof globalThis!=='undefined'?globalThis:null));");
                        } catch { }
                    }

                    createStandardObjects();
                    createWindowFunctionSortedList();

                    // Define constructors to route new calls through window.___createObject
                    try
                    {
                        // XMLHttpRequest
                        defineConstructor(typeof(CHtmlXMLHttpRequest), "XMLHttpRequest");
                        // Image (mapped to element IMG)
                        defineConstructor(typeof(CHtmlElement), "Image");
                        // DOMParser
                        defineConstructor(typeof(CHtmlDOMParser), "DOMParser");
                    }
                    catch (Exception exCtor)
                    {
                        System.Diagnostics.Debug.WriteLine("NilJs: defineConstructor error " + exCtor.Message);
                    }

                    ___InitGlobalAliases(globalContext);
                    _isInitCompleted = true;
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"NilJS initScriptEngine failed: {ex.Message}");
                    try
                    {
                        context = new NiL.JS.Core.Context();
                        processor = new NilJsProcessor();
                        processor.multiversalscope = this;
                        _isInitCompleted = true;
                        createBasicStandardObjects();
                        createWindowFunctionSortedList();
                        // Fallback constructors
                        try
                        {
                            defineConstructor(typeof(CHtmlXMLHttpRequest), "XMLHttpRequest");
                            defineConstructor(typeof(CHtmlElement), "Image");
                            defineConstructor(typeof(CHtmlDOMParser), "DOMParser");
                        }
                        catch { }
                    }
                    catch (Exception fallbackEx)
                    {
                        System.Diagnostics.Debug.WriteLine($"NilJS fallback init failed: {fallbackEx.Message}");
                        throw new InvalidOperationException("Failed to initialize NiL.JS engine", fallbackEx);
                    }
                }
            }
        }
        private  void EnsureWindowGlobal(Context ctx, IMultiversalWindow sourceWindow)
        {
            if (ctx == null || sourceWindow == null) return;

            var g = ctx.GlobalContext;

            // グローバルオブジェクトそのもの取得
            JSValue globalObject;
            try { globalObject = ctx.Eval("(function(){return this;})()"); } catch { globalObject = JSValue.Undefined; }

            JSValue windowProp = JSValue.Undefined;
            try
            {
                if (globalObject != null &&
                    globalObject.ValueType != JSValueType.Undefined &&
                    globalObject.ValueType != JSValueType.NotExistsInObject)
                {
                    windowProp = globalObject["window"]; // may be undefined
                }
            }
            catch { }

            var jsWindow = (windowProp != null && windowProp.ValueType != JSValueType.Undefined && windowProp.ValueType != JSValueType.NotExistsInObject)
                ? windowProp
                : JSValue.Marshal(sourceWindow);

            g.DefineVariable("window").Assign(jsWindow);
            g.DefineVariable("globalThis").Assign(jsWindow);
            g.DefineVariable("self").Assign(jsWindow);
            g.DefineVariable("global").Assign(jsWindow);

#if DEBUG
            System.Diagnostics.Debug.WriteLine("EnsureWindowGlobal: window/globalThis/self/global を再定義しました。");
#endif
            // 無条件でイベント関数をコピー (後で ExternalFunction を再定義するためダミーでも良い)
            try
            {
                ctx.Eval(@"(function(){try{var w=(typeof window!=='undefined')?window:(typeof globalThis!=='undefined'?globalThis:this);if(w){if(typeof addEventListener==='function'){w.addEventListener=addEventListener;}if(typeof removeEventListener==='function'){w.removeEventListener=removeEventListener;}if(typeof dispatchEvent==='function'){w.dispatchEvent=dispatchEvent;}}}catch(e){}})();");
            }
            catch { }
        }

