using MultiHtmlCraft.Interfaces;
using NiL.JS;
using NiL.JS.Core;
using NiL.JS.Core.Functions;
using NiL.JS.Extensions;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Reflection;
namespace NilJsProcessor
{
    public class NilJsScope : IMultiversalScriptScope
    {
        private IMultiversalWindow multiwindow;
        public Context context;
        public GlobalContext globalContext;
        private IMultiversalScriptProcessor processor;
        private bool _inited;
        private readonly object _lock = new object();
        private IMultiversalWindowType _windowType = IMultiversalWindowType.Unknown;
        private int _timeout;
        private static readonly string[] _invokeNames = new[]{"text/javascript","javascript","application/javascript"};
        public NilJsScope() { }
        public NilJsScope(IMultiversalWindow w){ multiwindow = w; }
        public string getMultivasalScopeName() => "NilJsScope";
        public string[] getMultiversalInvokeScriptNames() => _invokeNames;
        public bool isDefaultMultiversalProcessor() => true;
        public IMultiversalScriptProcessor getMultiversalScriptProcessor(){ if(processor!=null) processor.multiversalscope=this; return processor; }
        public IMultiversalWindow getMultiversalWindow() => multiwindow;
        public void setMutilversalWindowType(IMultiversalWindowType windowType){ _windowType = windowType; }
        public IMultiversalWindowType getMutilversalWindowType() => _windowType;
        public void setMultiversalWindow(IMultiversalWindow window){ multiwindow = window; rebindWindowGlobals(); }
        public void setTimeout(int timeout){ _timeout = timeout; }
        public bool isInitCompleted() => _inited;
        public void relaseMultiversal(){ multiwindow = null; }
        public void disposeScriptEngine(){ _inited=false; context=null; globalContext=null; processor=null; }

        private object invokeWindowCreateObject(string typeName, object[] ctorArgs){
            if(multiwindow==null) return null;
            try{
                // Try public instance method first via reflection to avoid explicit interface NotImplemented
                var t = multiwindow.GetType();
                var mi = t.GetMethod("___createObject", System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance);
                if(mi!=null){
                    var result = mi.Invoke(multiwindow, new object[]{ typeName, ctorArgs });
                    return result;
                }
            }catch(Exception ex){ System.Diagnostics.Debug.WriteLine("invokeWindowCreateObject reflection error: "+ex.Message); }
            try{ return multiwindow.___createObject(typeName, ctorArgs); }catch{ return null; }
        }
        private void ensureCreateObjectBridge(){
            if(context==null) return;
            var existing = context.GetVariable("__host_createObject");
            if(existing!=null && existing.ValueType==JSValueType.Function) return;
            var hostCreate = new ExternalFunction((thisArg,args)=>{
                try{
                    if(multiwindow==null||args==null||args.Length==0) return JSValue.Undefined;
                    var typeName = Convert.ToString(args[0].Value);
                    int n = Math.Max(0,args.Length-1);
                    var ctorArgs = new object[n];
                    for(int i=0;i<n;i++) ctorArgs[i]= args[i+1]?.Value; 
                    var inst = invokeWindowCreateObject(typeName, ctorArgs);
                    return inst==null? JSValue.Undefined: JSValue.Marshal(inst);
                }catch(Exception ex){ System.Diagnostics.Debug.WriteLine("NilJs hostCreate error: "+ex.Message); return JSValue.Undefined; }
            });
            context.DefineVariable("__host_createObject").Assign(hostCreate);

            // add host invoke bridge: __host_invoke(target, methodName, ...args)
            var hostInvoke = new ExternalFunction((thisArg, args) => {
                try {
                    if (args == null || args.Length < 2) return JSValue.Undefined;
                    var targetJs = args[0];
                    var methodName = Convert.ToString(args[1].Value);
                    object targetObj = targetJs?.Value;
                    if (targetObj == null) return JSValue.Undefined;
                    int m = Math.Max(0, args.Length - 2);
                    object[] margs = new object[m];
                    for (int i = 0; i < m; i++) margs[i] = args[i + 2]?.Value;
                    var mi = targetObj.GetType().GetMethod(methodName, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
                    if (mi == null)
                    {
                        // try case-insensitive search
                        mi = targetObj.GetType().GetMethods(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)
                            .FirstOrDefault(x => string.Equals(x.Name, methodName, StringComparison.OrdinalIgnoreCase));
                        if (mi == null) return JSValue.Undefined;
                    }
                    var result = mi.Invoke(targetObj, margs);
                    return result == null ? JSValue.Undefined : JSValue.Marshal(result);
                }
                catch (Exception ex) { System.Diagnostics.Debug.WriteLine("NilJs hostInvoke error: " + ex.Message); return JSValue.Undefined; }
            });
            context.DefineVariable("__host_invoke").Assign(hostInvoke);
            // attach to window if window exists
            try{ context.Eval("(function(){ if(typeof window!=='undefined'){ if(typeof window.___createObject!=='function'){ window.___createObject=function(){ return __host_createObject.apply(window, arguments); }; } } })();"); }catch{}
        }

        private void verifyGlobalConstructor(string name){
            if(context==null) return;
            try{
                var v = context.GetVariable(name);
                if(v==null || v.ValueType==JSValueType.Undefined){
                    context.Eval($"if(typeof {name}==='undefined' && typeof window!=='undefined' && window.{name}){{ {name}=window.{name}; }}");
                }
            }catch{ }
        }
        private void defineHostlessConstructor(string name){
            if(context==null) return; ensureCreateObjectBridge();
            if(name=="MutationObserver"){
                // Special proxy constructor to ensure methods are callable from JS
                string scriptMO = @"(function(){
                    function MutationObserver(callback){
                        try{
                            var f=(typeof window!=='undefined'&&typeof window.___createObject==='function')?window.___createObject:((typeof __host_createObject==='function')?__host_createObject:null);
                            var inst=null;
                            if(f){
                                var args = ['MutationObserver'];
                                for(var i=0;i<arguments.length;i++) args.push(arguments[i]);
                                inst = f.apply(window||this, args);
                            }
                            if(inst==null) return {};
                            return {
                                observe:function(target, options){ try{ return __host_invoke(inst, 'observe', target, options); }catch(e){} },
                                disconnect:function(){ try{ return __host_invoke(inst, 'disconnect'); }catch(e){} },
                                takeRecords:function(){ try{ return __host_invoke(inst, 'takeRecords'); }catch(e){} return []; }
                            };
                        }catch(e){ return {}; }
                    }
                    if(typeof globalThis!=='undefined') globalThis.MutationObserver=MutationObserver;
                    if(typeof window!=='undefined') window.MutationObserver=MutationObserver;
                    return MutationObserver;
                })()";
                try{ context.Eval(scriptMO); }catch(Exception ex){ System.Diagnostics.Debug.WriteLine("defineHostlessConstructor(MutationObserver) eval error: "+ex.Message); }
                try{ var ctor = context.GetVariable(name); if(ctor!=null && ctor.ValueType==JSValueType.Function){ context.DefineVariable(name).Assign(ctor); } }catch{}
                verifyGlobalConstructor(name);
                return;
            }
            if(name=="IntersectionObserver"){
                // Special proxy constructor similar to MutationObserver
                string scriptIO = @"(function(){
                    function IntersectionObserver(callback, options){
                        try{
                            var f=(typeof window!=='undefined'&&typeof window.___createObject==='function')?window.___createObject:((typeof __host_createObject==='function')?__host_createObject:null);
                            var inst=null;
                            if(f){
                                var args=['IntersectionObserver'];
                                for(var i=0;i<arguments.length;i++) args.push(arguments[i]);
                                inst = f.apply(window||this, args);
                            }
                            if(inst==null) return {};
                            return {
                                observe:function(target, options){ try{ return __host_invoke(inst, 'observe', target, options); }catch(e){} },
                                unobserve:function(target){ try{ return __host_invoke(inst, 'unobserve', target); }catch(e){} },
                                disconnect:function(){ try{ return __host_invoke(inst, 'disconnect'); }catch(e){} },
                                takeRecords:function(){ try{ return __host_invoke(inst, 'takeRecords'); }catch(e){} return []; }
                            };
                        }catch(e){ return {}; }
                    }
                    if(typeof globalThis!=='undefined') globalThis.IntersectionObserver=IntersectionObserver;
                    if(typeof window!=='undefined') window.IntersectionObserver=IntersectionObserver;
                    return IntersectionObserver;
                })()";
                try{ context.Eval(scriptIO); }catch(Exception ex){ System.Diagnostics.Debug.WriteLine("defineHostlessConstructor(IntersectionObserver) eval error: "+ex.Message); }
                try{ var ctor = context.GetVariable(name); if(ctor!=null && ctor.ValueType==JSValueType.Function){ context.DefineVariable(name).Assign(ctor); } }catch{}
                verifyGlobalConstructor(name);
                return;
            }
            // Generic constructor
            string scriptGeneric = $"function {name}(){{try{{var f=(typeof window!=='undefined'&&typeof window.___createObject==='function')?window.___createObject:((typeof __host_createObject==='function')?__host_createObject:null);if(f){{var a=['{name}'];for(var i=0;i<arguments.length;i++)a.push(arguments[i]);var r=f.apply(window||this,a);if(r!=null)return r;}}}}catch(e){{}}return {{}};}}; if(typeof globalThis!=='undefined') globalThis.{name}={name}; if(typeof window!=='undefined') window.{name}={name};";
            try{ context.Eval(scriptGeneric); }catch(Exception ex){ System.Diagnostics.Debug.WriteLine("defineHostlessConstructor eval error: "+ex.Message); }
            try{
                var ctor = context.GetVariable(name);
                if(ctor!=null && ctor.ValueType==JSValueType.Function){
                    context.DefineVariable(name).Assign(ctor);
                }
            }catch(Exception ex){ System.Diagnostics.Debug.WriteLine("defineHostlessConstructor bind error: "+ex.Message); }
            verifyGlobalConstructor(name);
        }
        public void defineConstructor(Type type, string jsName){ defineHostlessConstructor(jsName); }

        private void exposeWindowObject(){
            if(context==null || multiwindow==null) return;
            var win = JSValue.Marshal(multiwindow);
            context.DefineVariable("window").Assign(win);
            context.DefineVariable("globalThis").Assign(win);
            context.DefineVariable("self").Assign(win);
            try{
                context.Eval(@"(function(w){ if(!w) return; w.window=w; w.self=w; w.globalThis=w; w.___unifyCheck=function(){ return { windowEquals:(w===w.window), selfEquals:(w===w.self), globalThisEquals:(w===w.globalThis), thisEquals:(function(){return this;}).call(w)===w }; }; })(window);");
            }catch{ }
            ensureCreateObjectBridge();
        }
        private void rebindWindowGlobals(){
            if(!_inited) return; // only if already initialized
            exposeWindowObject();
        }

        private void basicGlobals(){
            if(context==null||multiwindow==null) return;
            context.DefineVariable("setTimeout").Assign(JSValue.Marshal(new Func<JSValue,JSValue,JSValue>((cb,ms)=> JSValue.Marshal(multiwindow.setTimeout(new object[]{cb.Value, ms.Value})) )));
            context.DefineVariable("setInterval").Assign(JSValue.Marshal(new Func<JSValue,JSValue,JSValue>((cb,ms)=> JSValue.Marshal(multiwindow.setInterval(new object[]{cb.Value, ms.Value})) )));
            context.DefineVariable("clearTimeout").Assign(JSValue.Marshal(new Action<JSValue>((id)=> multiwindow.clearTimeout(new object[]{id.Value}))));
            context.DefineVariable("clearInterval").Assign(JSValue.Marshal(new Action<JSValue>((id)=> multiwindow.clearInterval(new object[]{id.Value}))));
        }

        public void initScriptEngine(){
            lock(_lock){
                if(_inited) return;
                globalContext = new GlobalContext();
                context = new Context(globalContext);
                processor = new NilJsProcessor();
                processor.multiversalscope=this;
                exposeWindowObject();
                basicGlobals();
                // ensure hostless constructors that may have been requested earlier are defined
                defineHostlessConstructor("XMLHttpRequest");
                defineHostlessConstructor("Image");
                defineHostlessConstructor("DOMParser");
                // MutationObserver and IntersectionObserver should always be available in the JS environment
                defineHostlessConstructor("MutationObserver");
                defineHostlessConstructor("IntersectionObserver");
                verifyGlobalConstructor("XMLHttpRequest");
                verifyGlobalConstructor("Image");
                verifyGlobalConstructor("DOMParser");
                verifyGlobalConstructor("MutationObserver");
                verifyGlobalConstructor("IntersectionObserver");
                try{ var unify=context.Eval("window.___unifyCheck && window.___unifyCheck()"); System.Diagnostics.Debug.WriteLine("NilJs unify status: "+unify); }catch{}
                _inited=true;
            }
        }
    }
}