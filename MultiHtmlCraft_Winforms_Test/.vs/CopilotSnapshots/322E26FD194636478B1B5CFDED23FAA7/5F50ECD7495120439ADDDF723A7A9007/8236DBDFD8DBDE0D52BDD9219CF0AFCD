        public async Task navigate(string URL, params object[] args)
        {
            this.ActiveControl = null;
            string strMethod = "GET";
            CHtmlRequestData? _requestData = null;
            if (args !=null && args.Length > 0 )
            {
                if (args[0] is CHtmlRequestData)
                {
                    _requestData = (CHtmlRequestData)args[0];
                    URL = _requestData.fields["url"];
                    strMethod = _requestData.fields["method"] ?? "GET";

                }
            }

            string strUrl = URL.Trim();

            if (!strUrl.StartsWith("http"))
            {
                if (this.InvokeRequired)
                {
                    this.Invoke(new Action(() => MessageBox.Show($"{strUrl} is invalid url")));
                }
                else
                {
                    MessageBox.Show($"{strUrl} is invalid url");
                }
                return;
            }

            this.___multiversalWindow.___URL_Request_Current = URL;
            this.___multiversalWindow.setMultiversalControl(this);

            if (___multiversalWindow.hasHttpClient == false)
            {
                HttpClient ___httpClient = new HttpClient(httpclientHandler);

                commonHTML.setHttpClientDefalutRequestHeaders(___httpClient);



                ___httpClient.Timeout = TimeSpan.FromMilliseconds(30000);
                MultiHtmlCraft.Core.CHtmlMultiversalWindow.setHttpClient(___httpClient);
            }
            this.___multiversalWindow.___URL_Request_Current = URL;
            MultiHtmlCraft.Core.commonLog.LoggingEnabled = true;
            MultiHtmlCraft.Core.commonLog.LogLevel = 10;

            commonLog.LoggingEnabled = true;
            commonLog.LogLevel = 10;

            if (commonLog.LoggingEnabled)
            {
                commonLog.LogEntry($"Requesting {strUrl} Managed Thread ID :{System.Threading.Thread.CurrentThread.ManagedThreadId}");
            }
            try
            {
                ___document = await MultiHtmlCraft.Core.CHtmlDocument.createDocument(CHtmlDomModeType.HTMLDOM, strUrl, this.___multiversalWindow, _requestData);
                if (___document?.body is CHtmlElement ___body)
                {
                    if (this.InvokeRequired)
                    {
                        this.Invoke(new Action(() => setRenderingSize(___body.offsetWidth, ___body.offsetHeight)));
                    }
                    else
                    {
                        setRenderingSize(___body.offsetWidth, ___body.offsetHeight);
                    }
                }

                if (this.InvokeRequired)
                {
                    this.Invoke(new Action(() =>
                    {
                        if (!this.horizontalBar.Visible)
                            this.horizontalBar.Visible = true;
                        if (!this.verticalBar.Visible)
                            this.verticalBar.Visible = true;

                        if (___document.___ManagedControlPendingElementList != null && ___document.___ManagedControlPendingElementList.Count > 0)
                        {
                            if (___document.___HtmlGraphics == null)
                            {
                                ___document.___HtmlGraphics = new CHtmlGraphicContainer();
                                ___document.___HtmlGraphics.Graphic = this.CreateGraphics();
                            }
                            this.createControlFromDocument(this.___document);
                        }
                        this.Invalidate();
                        if (treeViewDOM != null && treeViewDOM.Visible == true)
                        {

                            createDOMTree();
                        }
                    }));
                }
                else
                {
                    if (!this.horizontalBar.Visible)
                        this.horizontalBar.Visible = true;
                    if (!this.verticalBar.Visible)
                        this.verticalBar.Visible = true;
                    this.Invalidate();
                    if (treeViewDOM != null)
                    {
                        createDOMTree();


                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.ToString());
            }
        }

        public void NavigateSync(string URL)
        {
            navigate(URL).GetAwaiter().GetResult();
        }

        private void createDOMTree()
        {
            if (___document?.documentElement is CHtmlElement documentRootElement)
            {
                this.treeViewDOM.SuspendLayout();
                treeViewDOM.BeginUpdate();
                treeViewDOM.Nodes.Clear();
                treeViewDOM.Nodes.Add(createTreeNodeFromCHtmlElement(documentRootElement));
                // TopNodeを保存
                TreeNode? prevTopNode = treeViewDOM.TopNode;
                treeViewDOM.ExpandAll();




                // TopNodeを復元
                if (prevTopNode != null)
                    treeViewDOM.TopNode = prevTopNode;


                this.treeViewDOM.ResumeLayout(false);
            }
        }
