        private Graphics? GetCachedGraphics()
        {
            var now = DateTime.Now;

            // キャッシュが古い場合は削除
            if (_cachedGraphics != null &&
                (now - _lastGraphicsCreated).TotalMilliseconds > GRAPHICS_CACHE_TIMEOUT_MS)
            {
                ClearGraphicsCache();
            }

            // キャッシュがない場合は新規作成
            if (_cachedGraphics == null && this.IsHandleCreated)
            {
                try
                {
                    _cachedGraphics = Graphics.FromHwnd(this.Handle);
                    _lastGraphicsCreated = now;
                }
                catch
                {
                    return null;
                }
            }

            return _cachedGraphics;
        }
        private void SetHighSpeedDrawingMode(Graphics graphics)
        {
            graphics.CompositingMode = System.Drawing.Drawing2D.CompositingMode.SourceCopy;
            graphics.CompositingQuality = System.Drawing.Drawing2D.CompositingQuality.HighSpeed;
            graphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.NearestNeighbor;
            graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.None;
            graphics.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighSpeed;
        }

        public void DrawImage(object image, RectangleFSpec rectFSpec)
        {
            if (!(image is Image img) || this.Disposing)
                return;

            // InvokeRequiredチェックを統一
            if (this.InvokeRequired)
            {
                this.BeginInvoke(new Action(() => DrawImageInternal(img, rectFSpec)));
                return;
            }

            DrawImageInternal(img, rectFSpec);
        }
        private void DrawImageInternal(Image image, RectangleFSpec rectFSpec)
        {
            if (this.Disposing || !this.IsHandleCreated)
                return;

            lock (_drawImageLock)
            {
                try
                {
         
                    var graphics = GetCachedGraphics();
                    //var graphics = Graphics.FromHwnd(this.Handle);
                    if (graphics != null)
                    {
                        var rect = commonTypeConverter.ToRectangle(rectFSpec);

                        // より高速な描画オプションを設定
                        graphics.CompositingMode = System.Drawing.Drawing2D.CompositingMode.SourceCopy;
                        graphics.CompositingQuality = System.Drawing.Drawing2D.CompositingQuality.HighSpeed;
                        graphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.NearestNeighbor;
                        graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.None;
                        graphics.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighSpeed;

                        graphics.DrawImage(image, rect);
                    }
                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                    {
                        commonLog.LogEntry("DrawImage exception: {0}", ex);
                    }
                    // キャッシュをクリアして次回再作成
                    ClearGraphicsCache();
                }
            }
        }


        private void ClearGraphicsCache()
        {
            _cachedGraphics?.Dispose();
            _cachedGraphics = null;
            _lastGraphicsCreated = DateTime.MinValue;

            // キャッシュクリア時に軽量なGCを実行
            if ((DateTime.Now - _lastGCCollectTime).TotalMilliseconds > 1000) // 1秒以上経過時のみ
            {
                try
                {
                    GC.Collect(0, GCCollectionMode.Optimized);
                    _lastGCCollectTime = DateTime.Now;
                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                    {
                        commonLog.LogEntry("GC.Collect in ClearGraphicsCache failed: {0}", ex.Message);
                    }
                }
            }
        }





        private void ___createControlFromDocumentForElement(CHtmlDocument ___doc, CHtmlElement __element)
        {
            try
            {
                string ___strText = null;
                if (__element.___IsElementVisible == false)
                {
                    return;
                }
                if (__element.___ManagedControlWeakReference == null)
                {
                    System.Drawing.Color ___ControlBackColor = Color.White;
                    System.Drawing.Color ___ControlForeColor = Color.Black;
                    if (__element.___style.___IsBackgroundColorSpecified == true)
                    {
                        ___ControlBackColor = System.Drawing.Color.FromArgb(__element.___style.___BackgroundSysColor.R, __element.___style.___BackgroundSysColor.G, __element.___style.___BackgroundSysColor.B);
                    }
                    if (__element.___style.___IsForegroundSysColorSpecified == true)
                    {
                        ___ControlForeColor = System.Drawing.Color.FromArgb(__element.___style.___ForegroundSysColor.R, __element.___style.___ForegroundSysColor.G, __element.___style.___ForegroundSysColor.B);
                    }
                    int ___ControlWidth = (int)__element.___offsetWidth;
                    int ___ControlHeight = (int)__element.___offsetHeight;
                    bool ___IsControlCreatedSuccess = false;
                    switch (__element.___elementTagType)
                    {
                        case CHtmlElementType.TEXTAREA:
                            // ...既存のTEXTAREA処理...
                            ___IsControlCreatedSuccess = true;
                            break;
                        case CHtmlElementType.INPUT:
                            if (string.Equals(__element.type, "hidden", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                return;
                            }
                            else
                            {
                                ___strText = commonHTML.GetElementAttributeInString(__element, "value");
                                switch (__element.type)
                                {
                                    case "button":
                                    case "Button":
                                    case "BUTTON":
                                    case "reset":
                                    case "submit":
                                    case "Submit":
                                    case "SUBMIT":
                                        System.Windows.Forms.Button ___buttonInput = new Button();
                                        ___buttonInput.BackColor = ___ControlBackColor;
                                        ___buttonInput.ForeColor = ___ControlForeColor;
                                        ___buttonInput.Width = ___ControlWidth;
                                        ___buttonInput.Height = ___ControlHeight;
                                        createCHtmlMultiversalRendererEventHandlerToControl(___buttonInput, this, __element);
                                        ___buttonInput.Tag = new System.WeakReference(__element, false);
                                        if (string.IsNullOrEmpty(___strText) == false)
                                        {
                                            ___buttonInput.Text = ___strText;
                                        }
                                        else
                                        {
                                            ___buttonInput.Text = __element.type;
                                        }
                                        this.Controls.Add(___buttonInput);
                                        __element.___ManagedControlWeakReference = new WeakReference(___buttonInput, false);
                                        ___IsControlCreatedSuccess = true;
                                        break;
                                    default:
                                        break;
                                }
                            }
                            break;
                        default:
                            break;
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(ex.ToString());
            }
        }
