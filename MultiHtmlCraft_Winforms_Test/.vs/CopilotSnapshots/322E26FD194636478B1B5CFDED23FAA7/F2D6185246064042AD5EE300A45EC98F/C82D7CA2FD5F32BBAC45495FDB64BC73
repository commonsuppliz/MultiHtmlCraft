        private async void CraftWinformControl_Click(object? sender, EventArgs e)
        {
            MultiHtmlCraft.Core.commonLog.LogEntry("[WinformsControl] Click event: sender={0}, type={1}", sender, sender?.GetType().Name);
            CHtmlElement _eventElement = null;
            object ___objFunction = null;

            if (sender is Control control)
            {
                if (control.Tag is WeakReference weakRef && weakRef.IsAlive)
                {
                    _eventElement = weakRef.Target as CHtmlElement;
                }
            }
            if (_eventElement != null)
            {
                if (_eventElement.___elementTagType == CHtmlElementType.INPUT && _eventElement.type == "submit")
                {
                    if(commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                    {
                        MultiHtmlCraft.Core.commonLog.LogEntry("[WinformsControl] Click event: sender={0}, type={1} Element={2} is submit button", sender, sender?.GetType().Name, _eventElement);
                    }
                    CHtmlRequestData _requestData = null;
                    if(this.___document!= null)
                    {
                         _requestData =  CHtmlElement.___createSubmitDocumentFormData(_eventElement);
                        if (_requestData != null && _requestData.fields.Count > 0)
                        {
                            foreach (var field in _requestData.fields)
                            {
                                MultiHtmlCraft.Core.commonLog.LogEntry($"{field.Key}, {field.Value}");
                            }
                            try
                            {
                                
                                string strUrl = string.Format("{0}", _requestData.fields["action"]);
                                strUrl = commonHTML.GetAbsoluteUri(this.___document.URL, "", strUrl);
                                _requestData.fields["url"] = strUrl;
                                await Task.Run(async () => await this.navigate(strUrl, new object[] { _requestData }));

                            }
                            catch (Exception ex)
                            {
                                MultiHtmlCraft.Core.commonLog.LogEntry("Error while navigating on submit button click: {0}", ex);
                            }
                        }
                    }
                    return;
                }
            }

             ___objFunction = ___getSendersFunctionObject(sender, "click", _eventElement);
            MultiHtmlCraft.Core.commonLog.LogEntry("[WinformsControl] Click event: sender={0}, type={1} Element={2} EventFunc={3}", sender, sender?.GetType().Name, _eventElement, ___objFunction);
            if (___objFunction != null)
            {
                this.___multiversalWindow.___executeElementEventFunction("click", _eventElement, ___objFunction, new object[] { null });
            }
        }
