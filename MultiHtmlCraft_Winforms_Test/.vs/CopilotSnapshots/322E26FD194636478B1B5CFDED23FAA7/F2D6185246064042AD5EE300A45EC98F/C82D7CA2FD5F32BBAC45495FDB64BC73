        private Graphics? GetCachedGraphics()
        {
            var now = DateTime.Now;

            // キャッシュが古い場合は削除
            if (_cachedGraphics != null &&
                (now - _lastGraphicsCreated).TotalMilliseconds > GRAPHICS_CACHE_TIMEOUT_MS)
            {
                ClearGraphicsCache();
            }

            // キャッシュがない場合は新規作成
            if (_cachedGraphics == null && this.IsHandleCreated)
            {
                try
                {
                    _cachedGraphics = Graphics.FromHwnd(this.Handle);
                    _lastGraphicsCreated = now;
                }
                catch
                {
                    return null;
                }
            }

            return _cachedGraphics;
        }
        private void SetHighSpeedDrawingMode(Graphics graphics)
        {
            graphics.CompositingMode = System.Drawing.Drawing2D.CompositingMode.SourceCopy;
            graphics.CompositingQuality = System.Drawing.Drawing2D.CompositingQuality.HighSpeed;
            graphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.NearestNeighbor;
            graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.None;
            graphics.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighSpeed;
        }

        public void DrawImage(object image, RectangleFSpec rectFSpec)
        {
            if (!(image is Image img) || this.Disposing)
                return;

            // InvokeRequiredチェックを統一
            if (this.InvokeRequired)
            {
                this.BeginInvoke(new Action(() => DrawImageInternal(img, rectFSpec)));
                return;
            }

            DrawImageInternal(img, rectFSpec);
        }
        private void DrawImageInternal(Image image, RectangleFSpec rectFSpec)
        {
            if (this.Disposing || !this.IsHandleCreated)
                return;

            lock (_drawImageLock)
            {
                try
                {
         
                    var graphics = GetCachedGraphics();
                    //var graphics = Graphics.FromHwnd(this.Handle);
                    if (graphics != null)
                    {
                        var rect = commonTypeConverter.ToRectangle(rectFSpec);

                        // より高速な描画オプションを設定
                        graphics.CompositingMode = System.Drawing.Drawing2D.CompositingMode.SourceCopy;
                        graphics.CompositingQuality = System.Drawing.Drawing2D.CompositingQuality.HighSpeed;
                        graphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.NearestNeighbor;
                        graphics.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.None;
                        graphics.PixelOffsetMode = System.Drawing.Drawing2D.PixelOffsetMode.HighSpeed;

                        graphics.DrawImage(image, rect);
                    }
                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                    {
                        commonLog.LogEntry("DrawImage exception: {0}", ex);
                    }
                    // キャッシュをクリアして次回再作成
                    ClearGraphicsCache();
                }
            }
        }


        private void ClearGraphicsCache()
        {
            _cachedGraphics?.Dispose();
            _cachedGraphics = null;
            _lastGraphicsCreated = DateTime.MinValue;

            // キャッシュクリア時に軽量なGCを実行
            if ((DateTime.Now - _lastGCCollectTime).TotalMilliseconds > 1000) // 1秒以上経過時のみ
            {
                try
                {
                    GC.Collect(0, GCCollectionMode.Optimized);
                    _lastGCCollectTime = DateTime.Now;
                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                    {
                        commonLog.LogEntry("GC.Collect in ClearGraphicsCache failed: {0}", ex.Message);
                    }
                }
            }
        }





