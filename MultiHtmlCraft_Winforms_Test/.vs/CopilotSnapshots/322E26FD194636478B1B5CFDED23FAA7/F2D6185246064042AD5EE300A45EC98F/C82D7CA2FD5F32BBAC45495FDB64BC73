        private void ___executeKeyPressEventForDocumentElements(string __eventTypeStr, CHtmlDocument ___activedocument, CHtmlWindowEvent __keyEvent)
        {

            ___activedocument.___createDocumentAllElementListFromDocumentElementIncludingITextBeforeAfter();

            int itemCount = ___activedocument.___getElementsByTagNameWildCardSearchIncludingITextLastResult_ALL_Count;
            if (itemCount > 0)
            {
                for (int i = itemCount - 1; i >= 0; i--)
                {
                    CHtmlElement ___element = ___activedocument.___getElementsByTagNameWildCardSearchIncludingITextLastResult[i] as CHtmlElement;
                    if (___element != null)
                    {
                        if (___element.___IsSystemHidden == false && ___element.___IsElementVisible == true)
                        {
                            switch (__eventTypeStr)
                            {
                                case "keydown":
                                    if (___element.___ElementKeyDownFunctionWeakReference != null)
                                    {
                                        this.___setSrcElementToElement(__keyEvent, ___element, null, true);
                                        CHtmlMultiversalWindow ___multiWindow = this.getMultiversalWindow();
                                        if (___multiWindow != null)
                                        {
                                            ___multiWindow.___executeElementEventFunction("keydown", ___element, ___element.___ElementKeyDownFunctionWeakReference.Target, new object[] { __keyEvent });
                                        }
                                    }
                                    continue;
                                case "keyup":
                                    if (___element.___ElementKeyUpFunctionWeakReference != null)
                                    {
                                        this.___setSrcElementToElement(__keyEvent, ___element, null, true);
                                        CHtmlMultiversalWindow ___multiWindow = this.getMultiversalWindow();
                                        if (___multiWindow != null)
                                        {
                                            ___multiWindow.___executeElementEventFunction("keyup", ___element, ___element.___ElementKeyUpFunctionWeakReference.Target, new object[] { __keyEvent });
                                        }
                                    }
                                    continue;
                                case "keypress":
                                    if (___element.___ElementKeyPressFunctionWeakReference != null)
                                    {
                                        this.___setSrcElementToElement(__keyEvent, ___element, null, true);
                                        CHtmlMultiversalWindow ___multiWindow = this.getMultiversalWindow();
                                        if (___multiWindow != null)
                                        {
                                            ___multiWindow.___executeElementEventFunction("keypress", ___element, ___element.___ElementKeyPressFunctionWeakReference.Target, new object[] { __keyEvent });
                                        }
                                    }
                                    continue;
                            }
                        }
                    }
                }
            }
