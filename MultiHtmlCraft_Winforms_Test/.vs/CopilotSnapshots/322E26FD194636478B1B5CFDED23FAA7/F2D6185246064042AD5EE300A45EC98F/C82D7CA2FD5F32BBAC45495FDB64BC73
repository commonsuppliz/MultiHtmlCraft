        private bool ___IsWindowFireEventProgress = false;
        private bool ___IsPaintOnProgress = false;
        private async void ___FireWindowEvent(string ___eventTypeStr, int ___x, int ___y, MouseButtons ___buttons, int ___clicks, int ___delta)
        {
            if (this.___IsWindowFireEventProgress == true)
            {
                return;
            }
            CHtmlDocument _doc = null;
            if (this.___IsPaintOnProgress == true)
            {
                this.___IsWindowFireEventProgress = false;
                return;
            }
            if (this.___multiversalWindow == null)
            {
                this.___IsWindowFireEventProgress = false;
                return;
            }
#if DEBUG

            DateTime eventStart = DateTime.Now;
#endif


            CHtmlEventDetail evtDetail = new CHtmlEventDetail();
            evtDetail.buttons = (CHtmlEventDetailMouseButtons)___buttons;
            evtDetail.clicks = ___clicks;
            evtDetail.delta = ___delta;
            evtDetail.eventname = ___eventTypeStr.ToString();
            this.___IsWindowFireEventProgress = true;

            // --- ここから修正 ---
            // もし eventTypeStr が "navigate" などで、navigate を呼び出す場合は、
            // ここで Task.Run + await で呼び出す。完了後に Cursor を戻す。
            // 例: "navigate" イベントのときに txtUrl.Text を使う場合
            if (___eventTypeStr == "navigate")
            {
                this.ActiveControl = null;
                this.Cursor = Cursors.AppStarting;
                
                string url = null;
                if (this.Parent is Form parentForm)
                {
                    var txtUrl = parentForm.Controls["txtUrl"] as TextBox;
                    if (txtUrl != null)
                    {
                        url = txtUrl.Text;
                    }
                }
                if (!string.IsNullOrEmpty(url))
                {
                    await Task.Run(async () =>
                    {
                        await this.navigate(url);
                    });
                }
                this.Cursor = Cursors.Default;
                this.___IsWindowFireEventProgress = false;
                return;
            }
            // --- ここまで修正 ---

            CHtmlWindowEvent ___mouseEventObject = ___createEventObjectForCursor(___eventTypeStr, true, null, ___buttons, ___clicks, ___delta);
            if (___eventTypeStr == "mousemove")
            {
                if (this.___LastMousePoint != Point.Empty)
                {
                    ___mouseEventObject.___lastMouseScreenXYPoint = commonTypeConverter.ToPointFSpec(this.___LastMousePoint);
                    ___mouseEventObject.___movementX = ___mouseEventObject.screenX - this.___LastMouseScreenXY.X;
                    ___mouseEventObject.___movementY = ___mouseEventObject.screenY - this.___LastMouseScreenXY.Y;
                }
            }


            CHtmlGraphicContainer grContainer = new CHtmlGraphicContainer();

            System.Collections.Generic.List<CHtmlElement> listElements = new System.Collections.Generic.List<CHtmlElement>();
            try
            {

                _doc = this.___multiversalWindow.document as CHtmlDocument;
                if (_doc == null)
                {
                    this.___IsWindowFireEventProgress = false;
                    return;
                }
                if (___eventTypeStr == "mousemove" || ___eventTypeStr == "mouseover")
                {
                    grContainer.IsHoverPaintMode = false;
                    if (_doc.___FiredEventsTrackedList != null && _doc.___FiredEventsTrackedList.Count > 0)
                    {
                        int ___FiredEventsTrackedListCount = _doc.___FiredEventsTrackedList.Count;
                        for (int t = ___FiredEventsTrackedListCount - 1; t >= 0; t--)
                        {
                            CHtmlElement ___trackedElement = _doc.___FiredEventsTrackedList.Keys[t] as CHtmlElement;
                            if (___trackedElement != null)
                            {
                                if (___trackedElement.___ScreenRectangle.Contains(___x, ___y) == false)
                                {
                                    try
                                    {
                                        string ___lastFiredType = null;
                                        _doc.___FiredEventsTrackedList.TryGetValue(___trackedElement, out ___lastFiredType);
                                        if (___lastFiredType == "hover")
                                        {
                                            _doc.drawRootElementRecursively(___trackedElement, ref grContainer);
                                        }
                                        else
                                        {
                                            // it is other than style hover. so it may be 
                                            // onmouseout, onmouseleave events are exists for the element.
                                            CHtmlAttribute attrActionOpposite = null;
                                            if (___trackedElement.attributes.Count > 0)
                                            {
                                                if (attrActionOpposite == null)
                                                {
                                                    ___trackedElement.___attributes.TryGetValue("mouseout", out attrActionOpposite);
                                                }
                                                else
                                                {
                                                    goto ActionFound;
                                                }
                                                if (attrActionOpposite == null)
                                                {
                                                    ___trackedElement.___attributes.TryGetValue("onmouseout", out attrActionOpposite);
                                                }
                                                else
                                                {
                                                    goto ActionFound;
                                                }
                                                if (attrActionOpposite == null)
                                                {
                                                    ___trackedElement.___attributes.TryGetValue("onmouseleave", out attrActionOpposite);
                                                }
                                                else
                                                {
                                                    goto ActionFound;
                                                }
                                                if (attrActionOpposite == null)
                                                {
                                                    ___trackedElement.___attributes.TryGetValue("mouseleave", out attrActionOpposite);
                                                }
                                                else
                                                {
                                                    goto ActionFound;
                                                }
                                            ActionFound:
                                                if (attrActionOpposite != null && attrActionOpposite.value != null)
                                                {
                                                    this.___setSrcElementToElement(___mouseEventObject, ___trackedElement, ___trackedElement, true);
                                                    CHtmlMultiversalWindow ___multiWindow = this.getMultiversalWindow();
                                                    if (___multiWindow != null)
                                                    {
                                                        ___multiWindow.___executeElementEventFunction(attrActionOpposite.name, ___trackedElement, attrActionOpposite.value, new object[] { ___mouseEventObject });
                                                    }
                                                    _doc.drawRootElementRecursively(___trackedElement, ref grContainer);
                                                }

                                            }
                                        }
                                    }
                                    catch (Exception exHandling)
                                    {
                                        if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                                        {
                                            commonLog.LogEntry("TrackEventHandlingError", exHandling);
                                        }
                                    }
                                    _doc.___FiredEventsTrackedList.RemoveAt(t);

                                }
                            }
                        }
                    }
                    grContainer.IsHoverPaintMode = true;
                }




                if (_doc != null)
                {
                    if (___eventTypeStr == "mousedown")
                    {
                        if (_doc.___ElementsContainsKeyUpOrKeyDownOrKeyPressList != null && _doc.___ElementsContainsKeyUpOrKeyDownOrKeyPressList.Count > 0)
                        {
                            _doc.___ElementsContainsKeyUpOrKeyDownOrKeyPressList.Clear();
                        }
                    }

                    // HTML.CHtmlAttribute __attrTarget = null;

                    //int ___ContinuousOverFlowYCount = 0;

