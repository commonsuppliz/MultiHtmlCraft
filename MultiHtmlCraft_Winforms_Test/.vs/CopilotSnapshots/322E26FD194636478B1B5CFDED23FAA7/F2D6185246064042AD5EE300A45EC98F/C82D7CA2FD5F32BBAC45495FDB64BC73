        private void TreeViewDOM_OnAfterSelect(object? sender, TreeViewEventArgs e)
        {
            var nodeSelected = e.Node;
            listViewDOM.BeginUpdate();
            listViewDOM.Items.Clear();
            if (nodeSelected != null)
            {
                if (listViewDOM != null)
                {


                    var elementSelected = nodeSelected.Tag as CHtmlElement;
                    if (elementSelected != null)
                    {
                        Dictionary<string, string> checkedProperties = new Dictionary<string, string>();
                        foreach (var namedProperty in CHtmlElement.CHtmlElementProperties)
                        {

                            var propValue = elementSelected.___getPropertyByName(namedProperty.Key);
                            if (propValue != null)
                            {
                                ListViewItem item = new ListViewItem(namedProperty.Key);
                                item.Name = namedProperty.Key;
                                item.SubItems.Add(propValue.ToString() ?? "null");
                                checkedProperties[namedProperty.Key] = propValue.ToString() ?? "null";
                                listViewDOM.Items.Add(item);
                            }


                        }
                        if (elementSelected.attributes != null)
                        {
                            foreach (var attr in elementSelected.attributes)
                            {
                                if (!checkedProperties.ContainsKey(attr.Key))
                                {
                                    ListViewItem item = new ListViewItem(attr.Key);
                                    item.Name = attr.Key;
                                    item.SubItems.Add($"{attr.Value}");
                                    listViewDOM.Items.Add(item);
                                }
                            }
                        }
                    }

                }

            }
            listViewDOM.EndUpdate();
        }

