        public MultiHtmlCraft.Core.CHtmlGraphicContainer? CreateGraphicContainer(System.Drawing.Graphics ___gr)
        {
            if (this.Disposing)
                return null;
            MultiHtmlCraft.Core.CHtmlGraphicContainer? ___htmlGraphics = null;
            ___htmlGraphics = new MultiHtmlCraft.Core.CHtmlGraphicContainer();
#if WINDOWS
            if (___gr != null)
            {
                ___htmlGraphics.Graphic = ___gr;
            }
            else
            {
                ___htmlGraphics.Graphic = this.CreateGraphics();
            }
            ___htmlGraphics.ImageNA = null;
#endif

            if (___htmlGraphics.FontSpec == null)
            {
                ___htmlGraphics.FontSpec = new FontSpec("", 12L);
            }
            ___htmlGraphics.BackgroundColor = commonTypeConverter.convertGDIColorToColorSpec(
(this.BackColor));
            ___htmlGraphics.ForegroundColor = commonTypeConverter.convertGDIColorToColorSpec(this.ForeColor);
            ___htmlGraphics.DisplayRectangle = commonTypeConverter.ToRectangleFSpec(this.DisplayRectangle);
            ___htmlGraphics.ClientRectangle = commonTypeConverter.ToRectangleFSpec(this.ClientRectangle);
            ___htmlGraphics.ControlBounds = commonTypeConverter.ToRectangleFSpec(this.Bounds);
          //  ___htmlGraphics.PaintRectangle = this.GetPaintRectScrollbar();

            ___htmlGraphics.StartingPos = 0;
            ___htmlGraphics.TotalOffsetLeft = 0;
            ___htmlGraphics.TotalOffsetTop = 0;
            System.Drawing.StringFormat sf = new StringFormat();
            sf.Trimming = System.Drawing.StringTrimming.Word;
            sf.FormatFlags = StringFormatFlags.MeasureTrailingSpaces;

            ___htmlGraphics.StandardStringFormat = sf;

            this.___LastPaintRectangle = ___htmlGraphics.PaintRectangle;
            return ___htmlGraphics;
        }

