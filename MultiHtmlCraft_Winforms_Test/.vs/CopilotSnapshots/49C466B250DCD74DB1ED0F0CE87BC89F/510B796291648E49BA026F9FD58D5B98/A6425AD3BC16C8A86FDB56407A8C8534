        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);
            Graphics gr = e.Graphics;

            var grCon = this.CreateGraphicContainer(e.Graphics);
            if (grCon == null) return;
            grCon.IsUIThreadPaint = true;
            grCon.Graphic = gr;
            grCon.PaintRectangle = this.GetPaintRectScrollbar();
            if (document != null && document.documentElement is CHtmlElement documentRootElement)
            {
                if (_documentPaintCount >= int.MaxValue)
                    _documentPaintCount = 0;
                _documentPaintCount++;
                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 15 && _documentPaintCount == 1)
                {
                    commonUtils.LogElementDOMTree(documentRootElement, "", commonUtils.CJHtmlDOMElementLogModeType.ElementWidthAndHeight);
                }

                document.drawRootElementRecursively(documentRootElement, ref grCon);
            }
        }
        private void TabControlSelectedIndexChanged(object? sender, EventArgs e)
        {
            if (tabControl == null)
                return;
            int currentTabIndex = tabControl.SelectedIndex;
            switch (currentTabIndex)
            {
                case 0: // DOM Tree
                    {

                    }
                    break;

                case 1: // CSS
                    {
                                
                            if(sideListViewCSS != null && document != null)
                            {
                            sideListViewCSS.BeginUpdate();
                            foreach (CHtmlCSSRule rule in document.cssRuleGroundList)
                            {
                                ListViewItem item = new ListViewItem(rule.SelectorID);
                                item.Name = rule.SelectorID;
                                item.SubItems.Add(rule.type.ToString());
                                //item.SubItems.Add(rule.style.toLogString());
                                sideListViewCSS.Items.Add(item);
                            }
                               sideListViewCSS.EndUpdate();
                        }
                            }
                    break;
                case 2: // Script
                    {
                        if (sideListViewScript != null && document != null && document.scriptEventList != null)
                        {
                            sideListViewScript.BeginUpdate();
                            sideListViewScript.Items.Clear();
                            int scriptCount = document.scriptEventList.Count;
                            for (int i = 0; i < scriptCount; i++)
                            {
                                CHtmlScriptResult scriptEventResult = document.scriptEventList[i] as CHtmlScriptResult;
                                if (scriptEventResult == null)
                                    continue;
                                else
                                {
                                    ListViewItem scriptResultListViewItem = new ListViewItem();
                                    if (!string.IsNullOrEmpty(scriptEventResult.Url))
                                    {
                                        scriptResultListViewItem.Text = scriptEventResult.Url;
                                        scriptResultListViewItem.Name = scriptEventResult.Url;
                                        scriptResultListViewItem.SubItems.Add(scriptEventResult.result.ToString() ?? "No Result");
                                    }
                                    else
                                    {
                                        scriptResultListViewItem.Text = "";
                                        scriptResultListViewItem.Name = scriptEventResult.Url;
                                        scriptResultListViewItem.SubItems.Add(scriptEventResult.result.ToString() ?? "No Result");
                                    }
                                    sideListViewScript.Items.Add(scriptResultListViewItem);

                                }

                            }
                            sideListViewScript.EndUpdate();

                        } break;



                           
             
                    }
            }

     
        }

