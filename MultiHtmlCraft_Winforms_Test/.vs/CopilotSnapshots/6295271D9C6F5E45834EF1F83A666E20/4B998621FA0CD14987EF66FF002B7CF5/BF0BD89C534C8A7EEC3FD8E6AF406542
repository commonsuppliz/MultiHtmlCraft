        public void disposeScriptEngine()
        {
            try
            {
                _isInitCompleted = false;
                processor = null;
                
                // contextを先にnullにしてからglobalContextをnullにする
                context = null;
                globalContext = null;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error disposing NilJS engine: {ex.Message}");
            }
        }

