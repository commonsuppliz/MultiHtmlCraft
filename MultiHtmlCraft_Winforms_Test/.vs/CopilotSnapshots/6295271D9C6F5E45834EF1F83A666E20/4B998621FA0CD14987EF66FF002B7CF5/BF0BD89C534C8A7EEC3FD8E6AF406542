        public void initScriptEngine()
        {
            lock (_initLock)
            {
                if (_isInitCompleted)
                    return;
                    
                try
                {
                    // GlobalContextを先に作成
                    globalContext = new GlobalContext();
                    globalContext.GlobalObjectsAssignMode = GlobalObjectsAssignMode.Allow;

                    // ContextをGlobalContextと関連付けて作成
                    context = new NiL.JS.Core.Context(globalContext);

                    processor = new NilJsProcessor();
                    processor.multiversalscope = this;

                    _isInitCompleted = true;
                    createStandardObjects();
                    createWindowFunctionSortedList();
                }
                catch (Exception ex)
                {
                    System.Diagnostics.Debug.WriteLine($"NilJS initScriptEngine failed: {ex.Message}");
                    
                    // フォールバック: より簡単な初期化
                    try
                    {
                        context = new NiL.JS.Core.Context();
                        processor = new NilJsProcessor();
                        processor.multiversalscope = this;
                        _isInitCompleted = true;
                        
                        createBasicStandardObjects();
                        createWindowFunctionSortedList();
                    }
                    catch (Exception fallbackEx)
                    {
                        System.Diagnostics.Debug.WriteLine($"NilJS fallback initialization also failed: {fallbackEx.Message}");
                        throw new InvalidOperationException("Failed to initialize NiL.JS engine", fallbackEx);
                    }
                }
            }
        }

