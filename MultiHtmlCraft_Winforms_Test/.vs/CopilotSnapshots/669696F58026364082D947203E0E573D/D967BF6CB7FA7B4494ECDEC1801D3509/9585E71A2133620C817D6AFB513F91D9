    public static class CHmlMultiversalWebCache

    {
        internal static object WebCacheLock = new object();
        internal static string MultiversalDataStoreFolder = "MultiversalDataStore";
        internal static string CachedData = "Cachedata.json";
        internal static string TrustedWenAuthorityData = "TrustedWenAuthority.json";
        public static List<string> TrustedWebAuthority = new List<string>();
        public static string StoregePath
        {
            get
            ; set;
        }
        internal static Dictionary<string, CHtmlMultivalContentData> CacheData = new Dictionary<string, CHtmlMultivalContentData>();
        internal static void initHTMLDataStorePath()
        {

            StoregePath = System.Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData) + System.IO.Path.DirectorySeparatorChar + MultiversalDataStoreFolder;
            if (System.IO.Directory.Exists(StoregePath) == false)
            {
                System.IO.Directory.CreateDirectory(StoregePath);
            }
            if (System.IO.File.Exists(StoregePath + System.IO.Path.DirectorySeparatorChar + CachedData) == true)
            {
                string _cachedData = System.IO.File.ReadAllText(StoregePath + System.IO.Path.DirectorySeparatorChar + CachedData);
                CacheData = JsonSerializer.Deserialize<Dictionary<string, CHtmlMultivalContentData>>(_cachedData);
            }
            if (System.IO.File.Exists(StoregePath + System.IO.Path.DirectorySeparatorChar + TrustedWenAuthorityData) == true)
            {
                string _trustedWenAuthorityData = System.IO.File.ReadAllText(StoregePath + System.IO.Path.DirectorySeparatorChar + TrustedWenAuthorityData);
                TrustedWebAuthority = JsonSerializer.Deserialize<List<string>>(_trustedWenAuthorityData);
            }
        }
        static CHmlMultiversalWebCache()
        {
            initHTMLDataStorePath();
        }
        public static void SaveCacheData()
        {
            string _cachedData = JsonSerializer.Serialize(CacheData);
            System.IO.File.WriteAllText(StoregePath + System.IO.Path.DirectorySeparatorChar + CachedData, _cachedData);

        }
        public static void SaveTrustedWebAuthority()
        {
            string _trustedWenAuthorityData = JsonSerializer.Serialize(TrustedWebAuthority);
            System.IO.File.WriteAllText(StoregePath + System.IO.Path.DirectorySeparatorChar + TrustedWenAuthorityData, _trustedWenAuthorityData);
        }

        // URLを正規化する（大文字小文字・末尾スラッシュ・不要な部分を統一）
        private static string NormalizeUrl(string url)
        {
            if (string.IsNullOrEmpty(url)) return url;
            try
            {
                var uri = new Uri(url);
                var builder = new UriBuilder(uri)
                {
                    Scheme = uri.Scheme.ToLowerInvariant(),
                    Host = uri.Host.ToLowerInvariant(),
                    Path = uri.AbsolutePath.TrimEnd('/'),
                    Query = uri.Query
                };
                // 末尾スラッシュを除去し、標準化
                return builder.Uri.GetLeftPart(UriPartial.Path).TrimEnd('/').ToLowerInvariant() + builder.Uri.Query;
            }
            catch
            {
                return url.Trim().ToLowerInvariant();
            }
        }

        internal static async Task<CHtmlMultivalContentData> getMultiversalContentData(string _url, string _contentType)
        {
            if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
            {
                commonLog.LogEntry("enter getMultiversalContentData {0} {1}  ManagedThreadID: {2}", _url, _contentType, System.Threading.Thread.CurrentThread.ManagedThreadId);
            }
            string normalizedUrl = NormalizeUrl(_url);
            CHtmlMultivalContentData multivasalContentData = null;
            CHtmlMultivalContentData result = null;
            bool lockTaken = false;
            try
            {
                if (System.Threading.Monitor.TryEnter(WebCacheLock, 3000))
                {
                    lockTaken = true;
                    if (CacheData.TryGetValue(normalizedUrl, out multivasalContentData) == true)
                    {
                        var httpClient = MultiHtmlCraft.Core.CHtmlMultiversalWindow.getHttpClient();
                        if (httpClient == null)
                        {
                            httpClient = new System.Net.Http.HttpClient();
                        }
                        var request = new HttpRequestMessage(HttpMethod.Get, _url);
                        if (multivasalContentData.LastModified.HasValue)
                        {
                            request.Headers.IfModifiedSince = multivasalContentData.LastModified.Value;
                        }
                        try
                        {
                            var response = await httpClient.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
                            if (response.StatusCode == HttpStatusCode.NotModified)
                            {
                                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                                {
                                    commonLog.LogEntry("object cache valid (304) within getMultiversalContentData {0} {1}  ManagedThreadID: {2}", _url, _contentType, System.Threading.Thread.CurrentThread.ManagedThreadId);
                                }
                                result = multivasalContentData;
                            }
                            else if (response.StatusCode == HttpStatusCode.OK)
                            {
                                var newContentData = CreateUrlContentDataPath(_url, _contentType);
                                if (commonHTML.isContentTypePlainText(_contentType))
                                {
                                    newContentData.HtmlContent = await response.Content.ReadAsStringAsync();
                                    newContentData.ContentLength = newContentData.HtmlContent.Length;
                                }
                                else
                                {
                                    newContentData.RawData = await response.Content.ReadAsByteArrayAsync();
                                    newContentData.ContentLength = newContentData.RawData.Length;
                                }
                                newContentData.LastModified = response.Content.Headers.LastModified;
                                newContentData.ContentType = response.Content.Headers.ContentType?.ToString() ?? _contentType;
                                newContentData.Url = _url;
                                newContentData.Authority = multivasalContentData.Authority;
                                var _fileLocation = StoregePath + newContentData.FileLocation;
                                var _directory = System.IO.Path.GetDirectoryName(_fileLocation);
                                if (!Directory.Exists(_directory))
                                {
                                    Directory.CreateDirectory(_directory);
                                }
                                if (commonHTML.isContentTypePlainText(_contentType))
                                {
                                    await System.IO.File.WriteAllTextAsync(_fileLocation, newContentData.HtmlContent);
                                }
                                else
                                {
                                    await System.IO.File.WriteAllBytesAsync(_fileLocation, newContentData.RawData);
                                }
                                CacheData[normalizedUrl] = newContentData;
                                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                                {
                                    commonLog.LogEntry("object cache updated (200) within getMultiversalContentData {0} {1}  ManagedThreadID: {2}", _url, _contentType, System.Threading.Thread.CurrentThread.ManagedThreadId);
                                }
                                result = newContentData;
                            }
                            else
                            {
                                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                                {
                                    commonLog.LogEntry($"object cache fallback (status: {response.StatusCode}) within getMultiversalContentData {{0}} {{1}}  ManagedThreadID: {{2}}", _url, _contentType, System.Threading.Thread.CurrentThread.ManagedThreadId);
                                }
                                result = multivasalContentData;
                            }
                        }
                        catch (Exception ex)
                        {
                            if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                            {
                                commonLog.LogEntry("Error checking server for cache update: ", ex);
                            }
                            result = multivasalContentData;
                        }
                    }
                }
                else
                {
                    throw new TimeoutException("Could not acquire WebCacheLock within timeout.");
                }
            }
            finally
            {
                if (lockTaken)
                {
                    System.Threading.Monitor.Exit(WebCacheLock);
                }
            }
            if (result != null)
            {
                return result;
            }
            var httpClientElse = MultiHtmlCraft.Core.CHtmlMultiversalWindow.getHttpClient();
            if (httpClientElse == null)
            {
                httpClientElse = new System.Net.Http.HttpClient();
            }
            multivasalContentData = CreateUrlContentDataPath(_url, _contentType);
            var _fileLocationElse = StoregePath + multivasalContentData.FileLocation;
            var _directoryElse = System.IO.Path.GetDirectoryName(_fileLocationElse);
            if (Directory.Exists(_directoryElse) == false)
            {
                Directory.CreateDirectory(_directoryElse);
            }
            if (System.IO.File.Exists(_fileLocationElse) == true)
            {
                if (commonHTML.isContentTypePlainText(_contentType) == true)
                {
                    multivasalContentData.HtmlContent = await System.IO.File.ReadAllTextAsync(_fileLocationElse);
                }
                else
                {
                    multivasalContentData.RawData = await System.IO.File.ReadAllBytesAsync(_fileLocationElse);
                }
                multivasalContentData.ContentLength = multivasalContentData.HtmlContent.Length;
                lock (WebCacheLock)
                {
                    CacheData[normalizedUrl] = multivasalContentData;
                }
                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                {
                    commonLog.LogEntry("exit getMultiversalContentData {0} {1}  ManagedThreadID: {2}", _url, _contentType, System.Threading.Thread.CurrentThread.ManagedThreadId);
                }
                return multivasalContentData;
            }
            else
            {
                var _httpContentDownload = new MultiHtmlCraft.Core.CHttpContentDownload();
                try
                {
                    var _task = await MultiHtmlCraft.Core.ContentBuilder.GetCHtttpContentAsync(httpClientElse, _url, _fileLocationElse, _httpContentDownload).ConfigureAwait(false);
                    if (_task != null)
                    {
                        if (System.IO.File.Exists(_fileLocationElse))
                        {
                            var fileInfo = new FileInfo(_fileLocationElse);
                            if (fileInfo.Length > int.MaxValue)
                            {
                                throw new InvalidOperationException("File is too large to read into memory.");
                            }
                            if (commonHTML.isContentTypePlainText(_contentType) == true)
                            {
                                multivasalContentData.HtmlContent = await System.IO.File.ReadAllTextAsync(_fileLocationElse);
                            }
                            else
                            {
                                multivasalContentData.RawData = await System.IO.File.ReadAllBytesAsync(_fileLocationElse);
                            }
                        }
                    }
                    multivasalContentData.ContentLength = _task.ContentLength;
                    lock (WebCacheLock)
                    {
                        CacheData[normalizedUrl] = multivasalContentData;
                    }
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                    {
                        commonLog.LogEntry("exit getMultiversalContentData {0} {1}  ManagedThreadID: {2}", _url, _contentType, System.Threading.Thread.CurrentThread.ManagedThreadId);
                    }
                    return multivasalContentData;
                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                    {
                        commonLog.LogEntry("Reading file Error : ", ex);
                    }
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                    {
                        commonLog.LogEntry("exit getMultiversalContentData {0} {1}  ManagedThreadID: {2}", _url, _contentType, System.Threading.Thread.CurrentThread.ManagedThreadId);
                    }
                    return multivasalContentData;
                }
            }
        }

    }
