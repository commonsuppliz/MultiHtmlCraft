        #region MultiversalRendererControlEvents

        protected override void OnMouseMove(MouseEventArgs e)
        {

            this.___FireWindowEvent("mousemove", e.X, e.Y, e.Button, e.Clicks, e.Delta);
            this.___LastMousePoint = new Point(e.X, e.Y);
            this.___LastMouseScreenXY = new Point(System.Windows.Forms.Cursor.Position.X, System.Windows.Forms.Cursor.Position.Y);
        }
        protected override void OnMouseDown(MouseEventArgs e)
        {

            this.___FireWindowEvent("mousedown", e.X, e.Y, e.Button, e.Clicks, e.Delta);


        }
        protected override void OnMouseEnter(EventArgs e)
        {
            this.___FireWindowEvent("mouseenter", this.___LastMousePoint.X, this.___LastMousePoint.Y, System.Windows.Forms.MouseButtons.None, 0, 0);
        }
        protected override void OnDoubleClick(EventArgs e)
        {

            this.___FireWindowEvent("dblclick", this.___LastMousePoint.X, this.___LastMousePoint.Y, System.Windows.Forms.MouseButtons.Left, 0, 0);
        }


        protected override void OnMouseClick(MouseEventArgs e)
        {

            this.___FireWindowEvent("mousedown", e.X, e.Y, e.Button, e.Clicks, e.Delta);
        }
        protected override void OnMouseLeave(EventArgs e)
        {

            this.___FireWindowEvent("mouseleave", 0, 0, System.Windows.Forms.MouseButtons.None, 0, 0);
        }
        protected override void OnMouseUp(MouseEventArgs e)
        {


            this.___FireWindowEvent("mouseup", e.X, e.Y, e.Button, e.Clicks, e.Delta);

        }
        protected override void OnMouseHover(EventArgs e)
        {

            this.___FireWindowEvent("mousehover", 0, 0, System.Windows.Forms.MouseButtons.None, 0, 0);
        }
