        internal void createControlFromDocument(CHtmlDocument ___doc)
        {
            if (this.InvokeRequired == true)
            {
                return;
            }
            else
            {
                int iContolCont = ___doc.___ManagedControlPendingElementList.Count;
                this.SuspendLayout();
                try
                {
                    for (int i = 0; i < iContolCont; i++)
                    {

                        if (i >= ___doc.___ManagedControlPendingElementList.Count)
                        {
                            break;
                        }
                        int __oid = ___doc.___ManagedControlPendingElementList.Keys[i];
                        CHtmlElement __element = ___doc.___ManagedControlPendingElementList.Values[i];
                        if (__element != null)
                        {
                            if (___doc.___isElementParentTraceableToDocument(__element) == true)
                            {
                                this.createControlFromDocumentForElement(___doc, __element);
                            }
                            else
                            {
                                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                                {
                                    commonLog.LogEntry("createControlFromDocument will skip {0}, because it is not traceable to root document.", __element);
                                }
                            }
                        }
                        ___doc.___ManagedControlPendingElementList.RemoveAt(i);
                        if (i >= 0 && ___doc.___ManagedControlPendingElementList.Count > 0)
                        {
                            i--;
                        }
                        if (___doc.___ManagedControlJobDoneList != null)
                        {
                            ___doc.___ManagedControlJobDoneList[__oid] = __element;
                        }

                        if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                        {
                            commonLog.LogEntry("createControlFromDocument for {0} done.", __element);
                        }
                    }

                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                    {
                        commonLog.LogEntry("createControlFromDocument Exception. ", ex);
                    }
                }
                this.ResumeLayout(false);

            }
        }

        private TreeNode createTreeNodeFromCHtmlElement(CHtmlElement element)
        {

            if (element == null || treeViewDOM == null || treeViewDOM.Visible == false)
            {
                if (treeViewDOM != null)
                {
                    treeViewDOM.Nodes.Clear();
                }
                return new TreeNode("DOM is Empty");
            }

            TreeNode node = new TreeNode(element.toLogString());
            node.Tag = element;
            CHtmlCollection ____currentChildNodes = element.children as CHtmlCollection;
            int ____currentChildNodesCount = ____currentChildNodes?.Count ?? 0;
            for (int i = 0; i < ____currentChildNodesCount; i++)
            {
                var child = ____currentChildNodes[i];
                if (child is CHtmlElement childElement)
                {
                    TreeNode elementNodeTree = new TreeNode(childElement.toLogString());
                    elementNodeTree.Tag = childElement;
                    node.Nodes.Add(createTreeNodeFromCHtmlElement(childElement));

                }
                else if (child is CHtmlTextElement textNode)
                {
                    TreeNode textNodeTree = new TreeNode(textNode.text);
                    textNodeTree.Tag = textNode;
                    node.Nodes.Add(textNodeTree);
                }
            }
            return node;
        }


