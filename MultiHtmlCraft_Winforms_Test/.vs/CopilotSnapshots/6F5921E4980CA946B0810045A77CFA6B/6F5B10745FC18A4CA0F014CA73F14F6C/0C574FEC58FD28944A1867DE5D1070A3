        private Graphics? GetCachedGraphics()
        {
            var now = DateTime.Now;

            // キャッシュが古い場合は削除
            if (_cachedGraphics != null &&
                (now - _lastGraphicsCreated).TotalMilliseconds > GRAPHICS_CACHE_TIMEOUT_MS)
            {
                ClearGraphicsCache();
            }

            // キャッシュがない場合は新規作成
            if (_cachedGraphics == null && this.IsHandleCreated)
            {
                try
                {
                    _cachedGraphics = Graphics.FromHwnd(this.Handle);
                    _lastGraphicsCreated = now;
                }
                catch
                {
                    return null;
                }
            }

            return _cachedGraphics;
        }




        private void ClearGraphicsCache()
        {
            _cachedGraphics?.Dispose();
            _cachedGraphics = null;
            _lastGraphicsCreated = DateTime.MinValue;

