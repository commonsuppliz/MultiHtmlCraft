        public SizeSpec(int width, int height)
        {
            Width = width;
            Height = height;
        }
        public static SizeSpec Empty => new SizeSpec(0, 0);
    }

    public struct SizeFSpec
    {
        public float Width, Height;
        public SizeFSpec(float width, float height)
        {
            Width = width;
            Height = height;
        }
        public static SizeFSpec Empty => new SizeFSpec(0, 0);
    }

    public struct RectangleSpec
    {
        public int X, Y, Width, Height;
        public RectangleSpec(int x, int y, int width, int height)
        {
            X = x;
            Y = y;
            Width = width;
            Height = height;
        }
        public static RectangleSpec Empty => new RectangleSpec(0, 0, 0, 0);
        public int Left => X;
        public int Top => Y;
        public int Right => X + Width;
        public int Bottom => Y + Height;

        public override bool Equals(object obj)
        {
            if (!(obj is RectangleSpec)) return false;
            var other = (RectangleSpec)obj;
            return X == other.X && Y == other.Y && Width == other.Width && Height == other.Height;
        }
        public override int GetHashCode()
        {
            return X.GetHashCode() ^ Y.GetHashCode() ^ Width.GetHashCode() ^ Height.GetHashCode();
        }
        public static RectangleSpec Union(RectangleSpec a, RectangleSpec b)
        {
            int x1 = Math.Min(a.Left, b.Left);
            int y1 = Math.Min(a.Top, b.Top);
            int x2 = Math.Max(a.Right, b.Right);
            int y2 = Math.Max(a.Bottom, b.Bottom);
            return new RectangleSpec(x1, y1, x2 - x1, y2 - y1);
        }
    }

    public struct RectangleFSpec
    {
        public float X, Y, Width, Height;
        public RectangleFSpec(float x, float y, float width, float height)
        {
            X = x;
            Y = y;
            Width = width;
            Height = height;
        }
        public static RectangleFSpec Empty => new RectangleFSpec(0, 0, 0, 0);
        public float Left => X;
        public float Top => Y;
        public float Right => X + Width;
        public float Bottom => Y + Height;

        public override bool Equals(object obj)
        {
            if (!(obj is RectangleFSpec)) return false;
            var other = (RectangleFSpec)obj;
            return X == other.X && Y == other.Y && Width == other.Width && Height == other.Height;
        }
        public override int GetHashCode()
        {
            return X.GetHashCode() ^ Y.GetHashCode() ^ Width.GetHashCode() ^ Height.GetHashCode();
        }
        public static RectangleFSpec Union(RectangleFSpec a, RectangleFSpec b)
        {
            float x1 = Math.Min(a.Left, b.Left);
            float y1 = Math.Min(a.Top, b.Top);
            float x2 = Math.Max(a.Right, b.Right);
            float y2 = Math.Max(a.Bottom, b.Bottom);
            return new RectangleFSpec(x1, y1, x2 - x1, y2 - y1);
        }

        // Adds an offset to the rectangle and returns a new RectangleFSpec
        public RectangleFSpec Offset(float dx, float dy)
        {
            return new RectangleFSpec(X + dx, Y + dy, Width, Height);
        }
        // Overload for PointFSpec
        public RectangleFSpec Offset(PointFSpec delta)
        {
            return new RectangleFSpec(X + delta.X, Y + delta.Y, Width, Height);
        }

        // Size property returns SizeFSpec
        public SizeFSpec Size => new SizeFSpec(Width, Height);
    }

