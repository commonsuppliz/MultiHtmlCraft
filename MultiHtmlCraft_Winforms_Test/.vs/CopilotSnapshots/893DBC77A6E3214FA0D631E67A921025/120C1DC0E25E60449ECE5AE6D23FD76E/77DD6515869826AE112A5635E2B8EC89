        public void setDcoument(ICHtmlDocumentInterface document)
        {
            if (_isInitCompleted)
            {
                _v8Engine.AddHostObject("__host_document", document);
                if (document is ICHtmlDocumentInterface)
                {
                    this._v8Engine.AddHostObject("location", ((ICHtmlDocumentInterface)document).location);

                }

                // Do not assign functions onto host document to avoid SetMember on host object
                dynamic dynDoc = document;
                // assign delegates so previously-registered placeholders can dispatch to dynDoc
                _docAddSoHandler = (eventName, handler) => { dynDoc.addEventListener(eventName, handler, null); };
                _docAdd3SoHandler = (eventName, handler, options) => { dynDoc.addEventListener(eventName, handler, options); };
                _v8Engine.AddHostObject("__doc_createElement", new Func<string, object>((tagName) => dynDoc.createElement(tagName)));
                _v8Engine.AddHostObject("__doc_getElementById", new Func<string, object>((id) => dynDoc.getElementById(id)));
                _v8Engine.AddHostObject("__doc_getElementsByTagName", new Func<string, object>((tagName) => dynDoc.getElementsByTagName(tagName)));
                _v8Engine.AddHostObject("__doc_getElementsByClassName", new Func<string, object>((className) => dynDoc.getElementsByClassName(className)));
                _v8Engine.AddHostObject("__doc_querySelector", new Func<string, object>((selector) => dynDoc.querySelector(selector)));
                _v8Engine.AddHostObject("__doc_querySelectorAll", new Func<string, object>((selector) => dynDoc.querySelectorAll(selector)));
                _v8Engine.AddHostObject("__doc_createEvent", new Func<string, object>((eventType) => dynDoc.createEvent(eventType)));
                _v8Engine.AddHostObject("__doc_createTextNode", new Func<object, object>((text) => dynDoc.createTextNode(text)));
                _v8Engine.AddHostObject("__doc_addEventListener", new Action<string, object>((eventName, handler) => dynDoc.addEventListener(eventName, handler, null)));
                _v8Engine.AddHostObject("__doc_addEventListener3", new Action<string, object, object>((eventName, handler, options) => dynDoc.addEventListener(eventName, handler, options)));
                _v8Engine.AddHostObject("__doc_removeEventListener", new Action<string, object>((eventName, handler) => dynDoc.removeEventListener(eventName, handler, null)));
                _v8Engine.AddHostObject("__doc_removeEventListener3", new Action<string, object, object>((eventName, handler, options) => dynDoc.removeEventListener(eventName, handler, options)));

                // Create a JS proxy object that exposes JS wrappers for methods but forwards property access to __host_document when missing
                // IMPORTANT: Prefer ScriptObject overload placeholders (__doc_addEventListener_so / __doc_addEventListener3_so)
                // when available, to avoid passing raw SplitProxy objects into host.
                // IMPORTANT: Prefer ScriptObject overload placeholders (__doc_addEventListener_so / __doc_addEventListener3_so)
                // when available, to avoid passing raw SplitProxy objects into host.
                _v8Engine.Execute(@"
                    (function(){
                        var host = __host_document;
                        // base proxy target containing JS wrappers for functions
                        var target = {};
                        target.createElement = function(tagName){ return __doc_createElement(tagName); };
                        target.getElementById = function(id){ return __doc_getElementById(id); };
                        target.getElementsByTagName = function(tag){ return __doc_getElementsByTagName(tag); };
                        target.getElementsByClassName = function(cls){ return __doc_getElementsByClassName(cls); };
                        target.querySelector = function(sel){ return __doc_querySelector(sel); };
                        target.querySelectorAll = function(sel){ return __doc_querySelectorAll(sel); };
                        target.createEvent = function(type){ return __doc_createEvent(type); };
                        target.createTextNode = function(text){ return __doc_createTextNode(text); };
                        target.addEventListener = function(name, handler, options){
                            if (arguments.length >= 3) { __doc_addEventListener3(name, handler, options); }
                            else { __doc_addEventListener(name, handler); }
                        };
                        target.removeEventListener = function(name, handler, options){
                            if (arguments.length >= 3) { __doc_removeEventListener3(name, handler, options); }
                            else { __doc_removeEventListener(name, handler); }
                        };

                        var docProxy = new Proxy(target, {
                            get: function(t, prop) {
                                console.log('document proxy get: ' + prop);
                                if (prop in t) return t[prop];
                                try {
                                    var v = host[prop];
                                    if (typeof v === 'function') {
                                        return function() { return v.apply(host, arguments); };
                                    }
                                    return v;
                                } catch(e) { return undefined; }
                            },
                            set: function(t, prop, value) {
                                console.log('document proxy set: ' + prop);
                                if (prop in t) { t[prop] = value; return true; }
                                try { host[prop] = value; return true; } catch(e) { t[prop] = value; return true; }
                            },
                            has: function(t, prop) { return (prop in t) || (prop in host); },
                            ownKeys: function(t) { try { return Reflect.ownKeys(t).concat(Reflect.ownKeys(host)); } catch(e) { return Reflect.ownKeys(t); } },
                            getOwnPropertyDescriptor: function(t, prop) {
                                if (prop in t) return Object.getOwnPropertyDescriptor(t, prop);
                                if (prop in host) return Object.getOwnPropertyDescriptor(host, prop);
                                return undefined;
                            }
