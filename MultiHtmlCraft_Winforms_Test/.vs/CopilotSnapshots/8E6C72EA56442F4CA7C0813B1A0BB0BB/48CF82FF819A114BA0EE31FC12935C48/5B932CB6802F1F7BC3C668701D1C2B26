        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);
            Graphics gr = e.Graphics;

            var grCon = this.CreateGraphicContainer(e.Graphics);
            if (grCon == null) return;
            grCon.IsUIThreadPaint = true;
            grCon.Graphic = gr;
            grCon.PaintRectangle = this.GetPaintRectScrollbar();
            if (document != null && document.documentElement is CHtmlElement documentRootElement)
            {
                if (_documentPaintCount >= int.MaxValue)
                    _documentPaintCount = 0;
                _documentPaintCount++;
                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 15 && _documentPaintCount == 1)
                {
                    commonUtils.LogElementDOMTree(documentRootElement, "", commonUtils.CJHtmlDOMElementLogModeType.ElementWidthAndHeight);
                }

                document.drawRootElementRecursively(documentRootElement, ref grCon);
            }
        }
        private void updateListView(object sender, EventArgs e)
        {
            if (tabControl == null) return;
            int currentTabIndex = tabControl.SelectedIndex;
            for (int i = 0; i < tabControl.TabPages.Count; i++)
            {
                foreach (Control ctrl in tabControl.TabPages[i].Controls)
                {
                    ctrl.Visible = (i == currentTabIndex);
                }
            }
        }

        protected override void OnClick(EventArgs e)
        {
