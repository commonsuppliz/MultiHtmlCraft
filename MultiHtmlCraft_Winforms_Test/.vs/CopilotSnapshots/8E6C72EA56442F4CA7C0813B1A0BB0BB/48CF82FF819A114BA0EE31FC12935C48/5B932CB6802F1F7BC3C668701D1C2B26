                sidePanel.Dock = DockStyle.Right;
                sidePanel.Width = this.Width / 4;
                sidePanel.BackColor = System.Drawing.Color.LightGray;

                tabControl = new TabControl();
                tabControl.Dock = DockStyle.Fill;
                tabControl.TabPages.Add("🌳"); // DOM Tree
                tabControl.TabPages.Add("🎨"); // CSS
                tabControl.TabPages.Add("📜"); // Script
                tabControl.TabPages.Add("⬇️"); // Download
                sidePanel.Controls.Add(tabControl);

                // DOM Panel (Panel + TreeView + Splitter + ListView)
                sidePanelDOM = new Panel { Dock = DockStyle.Fill };
                treeViewDOM = new TreeView { Dock = DockStyle.Left, Width = 180 };
                splitterDOM = new Splitter { Dock = DockStyle.Left, Width = 5, MinExtra = 100, MinSize = 50, BackColor = Color.LightSlateGray };
                listViewDOM = new ListView
                {
                    Dock = DockStyle.Fill,
                    View = View.Details,
                    FullRowSelect = true,
                    GridLines = true
                };
                listViewDOM.Columns.Add("Name", 180);
                listViewDOM.Columns.Add("Value", 100);
                listViewDOM.Columns.Add("Description", 200);
                listViewDOM.SuspendLayout();
                var domItems = new List<ListViewItem>();
                var rand = new Random();
                for (int i = 0; i < 300; i++)
                {
                    ListViewItem item = new ListViewItem($"Item {i + 1}");
                    item.Text = $"Item {rand.Next(100)}";
                    item.SubItems.Add($"Description {rand.Next(100)}");
                    item.SubItems.Add($"Value {rand.Next(1000)}");
                    domItems.Add(item);
                }
                listViewDOM.Items.AddRange(domItems.ToArray());
                listViewDOM.ResumeLayout();
                sidePanelDOM.Controls.Add(listViewDOM);
                sidePanelDOM.Controls.Add(splitterDOM);
                sidePanelDOM.Controls.Add(treeViewDOM);
                tabControl.TabPages[0].Controls.Add(sidePanelDOM);

                // ListView for CSS
                sideListViewCSS = new ListView
                {
                    Dock = DockStyle.Fill,
                    View = View.Details,
                    FullRowSelect = true,
                    GridLines = true
                };
                sideListViewCSS.Columns.Add("Name", 180);
                sideListViewCSS.Columns.Add("Value", 100);
                sideListViewCSS.Columns.Add("Description", 200);
                sideListViewCSS.SuspendLayout();
                var cssItems = new List<ListViewItem>();
                for (int i = 0; i < 300; i++)
                {
                    ListViewItem item = new ListViewItem($"CSS {i + 1}");
                    item.Text = $"CSS {rand.Next(100)}";
                    item.SubItems.Add($"CSS Desc {rand.Next(100)}");
                    item.SubItems.Add($"CSS Value {rand.Next(1000)}");
                    cssItems.Add(item);
                }
                sideListViewCSS.Items.AddRange(cssItems.ToArray());
                sideListViewCSS.ResumeLayout();
                tabControl.TabPages[1].Controls.Add(sideListViewCSS);

                // ListView for Script
                sideListViewScript = new ListView
                {
                    Dock = DockStyle.Fill,
                    View = View.Details,
                    FullRowSelect = true,
                    GridLines = true
                };
                sideListViewScript.Columns.Add("Name", 180);
                sideListViewScript.Columns.Add("Value", 100);
                sideListViewScript.Columns.Add("Description", 200);
                sideListViewScript.SuspendLayout();
                var scriptItems = new List<ListViewItem>();
                for (int i = 0; i < 300; i++)
                {
                    ListViewItem item = new ListViewItem($"Script {i + 1}");
                    item.Text = $"Script {rand.Next(100)}";
                    item.SubItems.Add($"Script Desc {rand.Next(100)}");
                    item.SubItems.Add($"Script Value {rand.Next(1000)}");
                    scriptItems.Add(item);
                }
                sideListViewScript.Items.AddRange(scriptItems.ToArray());
                sideListViewScript.ResumeLayout();
                tabControl.TabPages[2].Controls.Add(sideListViewScript);

                // Download tab: no ListView for now

                tabControl.SelectedIndexChanged += this.updateListView;

                this.Controls.Add(sidePanel);
                sidePanel.BringToFront();

                // Splitterの追加（sidePanelの左側に配置）
                sideSplitter = new Splitter();
                sideSplitter.Dock = DockStyle.Right;
                sideSplitter.Width = 5;
                sideSplitter.MinExtra = 100;
                sideSplitter.MinSize = 50;
                sideSplitter.BackColor = System.Drawing.Color.LightSlateGray;
                this.Controls.Add(sideSplitter);
                sideSplitter.BringToFront();

                closeButton = new Button();
                closeButton.Text = "❌";
                closeButton.FlatStyle = FlatStyle.Flat;
                closeButton.Width = 32;
                closeButton.Height = tabControl.ItemSize.Height > 0 ? tabControl.ItemSize.Height : 25;
                closeButton.BackColor = this.BackColor;

                this.Controls.Add(closeButton);
                closeButton.BringToFront();
                closeButton.Click += (s, args) =>
                {
                    this.Controls.Remove(closeButton);
                    this.Controls.Remove(sidePanel);
                    if (sideSplitter != null)
                    {
                        this.Controls.Remove(sideSplitter);
                        sideSplitter.Dispose();
                        sideSplitter = null;
                    }
                    sidePanel.Dispose();
                    sidePanel = null;
                    tabControl = null;
                    closeButton = null;
                    sidePanelDOM = null;
                    treeViewDOM = null;
                    splitterDOM = null;
                    listViewDOM = null;
                    sideListViewCSS = null;
                    sideListViewScript = null;
                };
                UpdateCloseButtonLocation();
            }
        }

        private void UpdateCloseButtonLocation()
        {
            if (closeButton != null && closeButton.Parent == this)
            {
                int x = this.ClientSize.Width - closeButton.Width - 4;
                int y = 2;
                closeButton.Location = new System.Drawing.Point(x, y);
                closeButton.BringToFront();
                closeButton.Visible = (sidePanel != null && sidePanel.Visible);
            }
        }

        protected override void OnResize(EventArgs e)
        {
            base.OnResize(e);
            this.SuspendLayout();
            this.horizontalBar.Location = new System.Drawing.Point(0, this.ClientSize.Height - this.horizontalBar.Height);
            this.horizontalBar.Size = new System.Drawing.Size(this.ClientSize.Width - this.verticalBar.Width, this.horizontalBar.Height);

            this.verticalBar.Location = new System.Drawing.Point(this.ClientSize.Width - this.verticalBar.Width, 0);
            this.verticalBar.Size = new System.Drawing.Size(this.verticalBar.Width, this.ClientSize.Height - this.horizontalBar.Height);
            int oldH = horizontalBar.Value;
            if (horizontalBar.Maximum > 0)
                horizontalBar.Value = (oldH == 0) ? 1 : 0;
            horizontalBar.Value = oldH;

            int oldV = verticalBar.Value;
            if (verticalBar.Maximum > 0)
                verticalBar.Value = (oldV == 0) ? 1 : 0;
            verticalBar.Value = oldV;
            if (sidePanel != null)
            {
                // sidePanelの幅はSplitterで調整されるのでここでは何もしない
            }
            this.ResumeLayout(false);
            UpdateCloseButtonLocation();
        }
        public MultiHtmlCraft.Core.CHtmlGraphicContainer? CreateGraphicContainer(System.Drawing.Graphics ___gr)
        {
            if (this.Disposing)
                return null;
            MultiHtmlCraft.Core.CHtmlGraphicContainer ___htmlGraphics = new MultiHtmlCraft.Core.CHtmlGraphicContainer();
            if (___gr != null)
            {
                ___htmlGraphics.Graphic = ___gr;
            }
            else
            {
                ___htmlGraphics.Graphic = this.CreateGraphics();
            }
            ___htmlGraphics.ImageNA = null;
            ___htmlGraphics.Font = this.Font.Clone() as Font ?? new Font(FontFamily.GenericSansSerif, 12f);
            ___htmlGraphics.BackgroundColor = MultiHtmlCraft.Core.ColorSpec.FromColor(this.BackColor);
            ___htmlGraphics.ForegroundColor = MultiHtmlCraft.Core.ColorSpec.FromColor(this.ForeColor);
            ___htmlGraphics.DisplayRectangle = this.DisplayRectangle;
            ___htmlGraphics.ClientRectangle = this.ClientRectangle;
            ___htmlGraphics.ControlBounds = this.Bounds;
            ___htmlGraphics.PaintRectangle = this.GetPaintRectScrollbar();

            ___htmlGraphics.StartingPos = 0;
            ___htmlGraphics.TotalOffsetLeft = 0;
            ___htmlGraphics.TotalOffsetTop = 0;
            System.Drawing.StringFormat sf = new StringFormat();
            sf.Trimming = System.Drawing.StringTrimming.Word;
            sf.FormatFlags = StringFormatFlags.MeasureTrailingSpaces;

            ___htmlGraphics.StandardStringFormat = sf;
            return ___htmlGraphics;
        }
        public Rectangle GetPaintRectScrollbar()
        {
            if (this.Disposing == true)
                return Rectangle.Empty;
            int ___horizontalBarValue = 0;

            int ___horizontalBarMaximum = 0;
            if (this.horizontalBar != null)
            {
                ___horizontalBarValue = this.horizontalBar.Value;
                ___horizontalBarMaximum = this.horizontalBar.Maximum;
            }
            else
            {
                ___horizontalBarMaximum = this.Width;
            }
            int _verticalBarValue = 0;


            int _verticalMaximum = 0;
            if (this.verticalBar != null)
            {
                _verticalMaximum = this.verticalBar.Maximum;
                _verticalBarValue = this.verticalBar.Value;
            }
            else
            {
                _verticalMaximum = this.Height;
            }

            int _HalfHeight = (int)((double)this.ClientRectangle.Height / (double)2);
            if (_verticalMaximum > this.ClientRectangle.Height && _verticalBarValue > _verticalMaximum - this.ClientRectangle.Height)
            {
                _verticalBarValue = _verticalMaximum - this.ClientRectangle.Height + 20;
            }


            if (___horizontalBarValue < 0)
            {
                if (this.horizontalBar != null)
                {
                    this.horizontalBar.SuspendLayout();
                    this.horizontalBar.Value = 0;
                    this.horizontalBar.ResumeLayout();
                }
            }
            if (_verticalBarValue < 0)
            {
                if (this.verticalBar != null)
                {
                    this.verticalBar.SuspendLayout();
                    this.verticalBar.Value = 0;
                    this.verticalBar.ResumeLayout();
                }
            }
            Rectangle dispRect = new Rectangle(___horizontalBarValue, _verticalBarValue, ___horizontalBarMaximum, _verticalMaximum);
            Rectangle cliRect = this.ClientRectangle;
            Rectangle PaintRect = new Rectangle(Math.Abs(dispRect.X), Math.Abs(dispRect.Y), cliRect.Width, cliRect.Height);
            return PaintRect;
        }

