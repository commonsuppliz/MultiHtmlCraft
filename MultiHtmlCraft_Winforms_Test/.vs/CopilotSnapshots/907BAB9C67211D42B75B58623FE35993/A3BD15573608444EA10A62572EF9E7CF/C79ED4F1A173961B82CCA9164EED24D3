        public override DynamicMetaObject BindGetMember(GetMemberBinder binder)
        {
            switch (this.Value)
            {
                case CHtmlElement element:
                    {
                        var self = element;
                        if (CHtmlElement.CHtmlElementProperties.ContainsKey(binder.Name))
                        {
                            var propertyInfo = GetCachedProperty(typeof(CHtmlElement), binder.Name);
                            if (propertyInfo == null)
                                propertyInfo = GetCachedProperty(typeof(CHtmlNode), binder.Name);
                            if (propertyInfo != null)
                            {
                                return new DynamicMetaObject(
                                    Expression.Property(Expression.Constant(self), propertyInfo),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                );
                            }
                        }
                        MethodInfo methodInfo = null;
                        if (CHtmlElement.CHtmlElementMethods.ContainsKey(binder.Name) == true)
                        {
                            switch (binder.Name)
                            {
                                case "insertBefore":
                                case "getContext":
                                case "removeChild":
                                case "getElementsByTagName":
                                case "setAttribute":
                                case "cloneNode":
                                case "addEventListener":
                                case "getAttribute":
                                    return base.BindGetMember(binder);
                                case "toString":
                                    Func<string> toStringFunc = () => element.ToString();
                                    return new DynamicMetaObject(
                                        Expression.Constant(toStringFunc),
                                        BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType));
                                case "appendChild":
                                    var methodInfoAppendChild = GetCachedMethod(typeof(CHtmlElement), "appendChild", new[] { typeof(CHtmlElement) });
                                    if (methodInfoAppendChild != null)
                                    {
                                        var del = Delegate.CreateDelegate(
                                            Expression.GetDelegateType(
                                                methodInfoAppendChild.GetParameters()
                                                    .Select(p => p.ParameterType)
                                                    .Concat(new[] { methodInfoAppendChild.ReturnType })
                                                    .ToArray()
                                            ),
                                            self,
                                            methodInfoAppendChild
                                        );
                                        return new DynamicMetaObject(
                                            Expression.Constant(del),
                                            BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                        );
                                    }
                                    break;
                                case "compareDocumentPosition":
                                    var methodcompareDocumentPosition = GetCachedMethod(typeof(CHtmlElement), "compareDocumentPosition", new Type[] { typeof(ICHtmlNodeInterface) });
                                    if (methodcompareDocumentPosition != null)
                                    {
                                        Func<object, double> delcompareDocumentPosition = (other) =>
                                        {
                                            if (other is ICHtmlNodeInterface node)
                                                return (double)methodcompareDocumentPosition.Invoke(self, new object[] { node });
                                            throw new ArgumentException("Argument must be ICHtmlNodeInterface");
                                        };
                                        return new DynamicMetaObject(
                                            Expression.Constant(delcompareDocumentPosition),
                                            BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                        );
                                    }
                                    break;
                            }
                            methodInfo = GetCachedMethod(typeof(CHtmlElement), binder.Name, Type.EmptyTypes);
                            if (methodInfo != null)
                            {
                                var del = Delegate.CreateDelegate(
                                    Expression.GetDelegateType(
                                        methodInfo.GetParameters()
                                            .Select(p => p.ParameterType)
                                            .Concat(new[] { methodInfo.ReturnType })
                                            .ToArray()
                                    ),
                                    self,
                                    methodInfo
                                );
                                return new DynamicMetaObject(
                                    Expression.Constant(del),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                );
                            }
                        }
                        var result = self.GetDynamicMember(binder.Name);
                        return new DynamicMetaObject(
                            Expression.Constant(result),
                            BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType));
                    }
                case CHtmlDocument _document:
                    {
                        var self = _document;
                        switch (binder.Name)
                        {
                            case "createElement":
                            case "getElementById":
                                {
                                    var methodWithOneString = typeof(CHtmlDocument).GetMethod(binder.Name, new Type[] { typeof(string) });
                                    if (methodWithOneString != null)
                                    {
                                        Func<object, CHtmlElement> delCreateElement = (strElemName) =>
                                        {
                                            if (strElemName is string)
                                            { 
                                            return (CHtmlElement)methodWithOneString.Invoke(self, new object[] { strElemName });
                                            }
                                            throw new ArgumentException("Argument must be string");
                                        };
                                        return new DynamicMetaObject(
                                            Expression.Constant(delCreateElement),
                                            BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                        );
                                    }
                                    break;
                                }
          
                        }
                            if (CHtmlDocument.CHtmlDocumentProperties.ContainsKey(binder.Name))
                        {
                            var propertyInfo = typeof(CHtmlDocument).GetProperties(BindingFlags.Instance | BindingFlags.Public)
.FirstOrDefault(p => p.Name == binder.Name && p.DeclaringType == typeof(CHtmlDocument))
?? typeof(CHtmlNode).GetProperties(BindingFlags.Instance | BindingFlags.Public)
.FirstOrDefault(p => p.Name == binder.Name && p.DeclaringType == typeof(CHtmlNode));
                            if (propertyInfo != null)
                            {
                                return new DynamicMetaObject(
                                    Expression.Property(Expression.Constant(self), propertyInfo),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                );
                            }
                        
                        }
                        if (CHtmlDocument.CHtmlDocumentMethods.ContainsKey(binder.Name))
                        {
                            var methodInfo = typeof(CHtmlDocument).GetMethod(binder.Name);
                            if (methodInfo != null)
                            {
                                var del = Delegate.CreateDelegate(
                                    Expression.GetDelegateType(
                                        (from parameter in methodInfo.GetParameters() select parameter.ParameterType)
                                        .Concat(new[] { methodInfo.ReturnType })
                                        .ToArray()
                                    ),
                                    self,
                                    methodInfo
                                );
                                return new DynamicMetaObject(
                                    Expression.Constant(del),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)

                                );

                            }
                        }
                        else // in case of the methods name not defined in CHtmlDocumentMethods
                        {
                            var methodInfo = typeof(CHtmlDocument).GetMethod(binder.Name);
                            if (methodInfo != null)
                            {
                                var del = Delegate.CreateDelegate(
                                    Expression.GetDelegateType(
                                        (from parameter in methodInfo.GetParameters() select parameter.ParameterType)
                                        .Concat(new[] { methodInfo.ReturnType })
                                        .ToArray()
                                    ),
                                    self,
                                    methodInfo
                                );
                                return new DynamicMetaObject(
                                    Expression.Constant(del),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)

                                );

                            }
                        }

                        var result = self.GetDynamicMember(binder.Name);
                        return new DynamicMetaObject(
    Expression.Constant(result),
    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType));
                    }
                case CHtmlWorkerWindow _workerWindow:

                    {
                        var self = _workerWindow;
                        var methodInfo = typeof(CHtmlMultiversalWindow).GetMethod(binder.Name);
                        if (methodInfo != null)
                        {
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(self), methodInfo),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        var result = self.GetDynamicMember(binder.Name);
                        return new DynamicMetaObject(
    Expression.Constant(result),
    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType));
                    }
                case CHtmlMultiversalWindow window:
                    {
                        var self = window;
                        var methodInfo = typeof(CHtmlMultiversalWindow).GetMethod(binder.Name);
                        if (methodInfo != null)
                        {
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(self), methodInfo),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        var result = self.GetDynamicMember(binder.Name);
                        return new DynamicMetaObject(
    Expression.Constant(result),
    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType));
                    }
                case CHtmlCSSStyleSheet _sheet:
                    {
                        var self = _sheet;
                        var methodInfo = typeof(CHtmlCSSStyleSheet).GetMethod(binder.Name);
                        if (methodInfo != null)
                        {
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(self), methodInfo),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        var result = self.GetDynamicMember(binder.Name);
                        return new DynamicMetaObject(
    Expression.Constant(result),
    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType));
                    }
                case CHtmlFontFace _fontFace:
                    {
                        var self = _fontFace;
                        if (CHtmlFontFace.CHtmlFontFaceProperties.ContainsKey(binder.Name))
                        {
                            var value = self.GetDynamicMember(binder.Name);
                            return new DynamicMetaObject(
                                Expression.Constant(value),
                                BindingRestrictions.GetTypeRestriction(this.Expression, typeof(CHtmlFontFace))
                            );
                        }
                            var methodInfo = typeof(CHtmlFontFace).GetMethod(binder.Name);
                            if (methodInfo != null)
                            {
                                return new DynamicMetaObject(
                                    Expression.Call(Expression.Constant(self), methodInfo),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                );
                            }
                            else {                                 var result = self.GetDynamicMember(binder.Name);
                                return new DynamicMetaObject(
                                    Expression.Constant(result),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                );
                            }
                        
                    }
                    break;

            
                case CHtmlConsole _console:
                    {
                        var self = _console;
                        switch(binder.Name)
                        {
                            case "log":
                            case "info":
                            case "assert":
                            case "count":
                            case "debug":
                            case "error":
                            case "clear":
                            case "grouop":
                            case "dir":
                            case "groupStart":
                            case "groupEnd":
                            case "dirxml":
                            case "groupCollapsed":
                            case "countReset":
                            case "profile":
                            case "profileEnd":
                            case "table":
                                return base.BindGetMember(binder);
                        }
                        var methodInfo = typeof(CHtmlConsole).GetMethod(binder.Name);
                        if (methodInfo != null)
