        public override DynamicMetaObject BindGetIndex(GetIndexBinder binder, DynamicMetaObject[] indexes)
        {

            switch (this.Value)
            {
                case CHtmlCollection _collection:
                    { }
                    // index[0] を int に変換
                    var indexExpr = Expression.Convert(indexes[0].Expression, typeof(int));
                    // this.Expression を CHtmlCollection 型に変換
                    var selfExpr = Expression.Convert(this.Expression, typeof(MultiHtmlCraft.Core.CHtmlCollection));
                    // インデクサープロパティ取得
                    var indexer = typeof(MultiHtmlCraft.Core.CHtmlCollection).GetProperty("Item", new[] { typeof(int) });
                    // インデクサー呼び出し式
                    var call = Expression.Property(selfExpr, indexer, indexExpr);

                    return new DynamicMetaObject(
                        call,
                        BindingRestrictions.GetTypeRestriction(this.Expression, typeof(MultiHtmlCraft.Core.CHtmlCollection))
                    );
            
            }

            // デフォルトの動作
            return base.BindGetIndex(binder, indexes);
        }
       

