        public override DynamicMetaObject BindConvert(ConvertBinder binder)
        {
          
            if (binder.Type == typeof(string))
            {
                var self = this.Value;
                var toStringMethod = self.GetType().GetMethod("ToString", Type.EmptyTypes);
                var callToString = Expression.Call(Expression.Constant(self), toStringMethod);
                return new DynamicMetaObject(
                    callToString,
                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                );
            }
            return base.BindConvert(binder);
        }
        // Helper: safely unwrap DynamicMetaObject wrappers or common script wrappers, return original if nothing to unwrap
        private static object? UnwrapValue(object? v)
        {
            if (v is null) return null;

            // If ClearScript delivered a DynamicMetaObject wrapper
            if (v is DynamicMetaObject dmo)
            {
                try { return dmo.Value; } catch { return null; }
            }

            // Some script engines wrap host objects; try common property names
            var t = v.GetType();
            var tryProps = new[] { "Target", "UnderlyingObject", "Value", "WrappedObject" };
            foreach (var pn in tryProps)
            {
                var p = t.GetProperty(pn, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
                if (p != null)
                {
                    try
                    {
                        var extracted = p.GetValue(v);
                        if (extracted != null) return extracted;
                    }
                    catch { /* ignore and continue */ }
                }
            }

            return v;
        }

