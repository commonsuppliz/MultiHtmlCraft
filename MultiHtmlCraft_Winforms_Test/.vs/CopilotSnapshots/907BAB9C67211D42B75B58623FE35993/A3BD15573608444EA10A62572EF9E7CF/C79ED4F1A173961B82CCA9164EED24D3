    /// <summary>
    /// This class is to support script engines which use DynamicObject. Since it is difficult to support DynamicObject in this project, DynamicMetaObject is used instead.
    /// </summary>
    public class CHtmlClearScriptDynamicMetaObject<T> : DynamicMetaObject
    {
        private static readonly ConcurrentDictionary<(Type, string, Type[] parameterTypes), MethodInfo> ClearScriptMetaObjectMethodCache = new();
        private static readonly ConcurrentDictionary<(Type, string), PropertyInfo> ClearScriptMetaObjectPropertyCache = new();

        // Method to get MethodInfo from cache or add it if not present
        private static MethodInfo GetCachedMethod(Type type, string methodName, Type[] parameterTypes)
        {
            // 修正前
            // var key = (type, methodName);
            // var method = ClearScriptMetaObjectMethodCache.GetOrAdd(key, _ => type.GetMethod(methodName, parameterTypes));

            // 修正後
            var key = (type, methodName, parameterTypes);
            return ClearScriptMetaObjectMethodCache.GetOrAdd(key, _ => type.GetMethod(methodName, parameterTypes));
        }

        // Method to get PropertyInfo from cache or add it if not present
        private static PropertyInfo GetCachedProperty(Type type, string propertyName)
        {
            var key = (type, propertyName);
            //return ClearScriptMetaObjectPropertyCache.GetOrAdd(key, _ => type.GetProperty(propertyName));
            var property = ClearScriptMetaObjectPropertyCache.GetOrAdd(key, _ => type.GetProperty(propertyName));
            return property ?? throw new MissingMemberException($"Property '{propertyName}' not found in type '{type.FullName}'.");
        }
        public CHtmlClearScriptDynamicMetaObject(System.Linq.Expressions.Expression expression, object value)
            : base(expression, BindingRestrictions.Empty, value)
        {
            
        }
        // Fix for CS1003: Ensure all 'switch' cases are properly closed with a 'break' statement or strElemName valid syntax.
        public override DynamicMetaObject BindInvokeMember(InvokeMemberBinder binder, DynamicMetaObject[] args)
        {


            switch (this.Value)
            {
                case CHtmlDocument self:
                    {
                        var methodInfo = GetCachedMethod(typeof(CHtmlDocument), binder.Name, args.Select(a => a.LimitType).ToArray());
                        if (methodInfo != null)
                        {
                            var parameters = methodInfo.GetParameters();
                            var callArgs = new Expression[parameters.Length];
                            for (int i = 0; i < parameters.Length; i++)
                            {
                                callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                            }
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(self), methodInfo, callArgs),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        break;
                    }

                case CHtmlElement _celement:
                    {
                        switch (binder.Name)
                        {

                            case "compareDocumentPosition":
                                {
                                    MethodInfo method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(ICHtmlNodeInterface) });
                                    var parameters = method.GetParameters();
                                    var callArgs = new Expression[parameters.Length];
                                    for (int i = 0; i < parameters.Length; i++)
                                    {
                                        callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                                    }
                                    return new DynamicMetaObject(
                                        Expression.Call(Expression.Constant(_celement), method, callArgs),
                                        BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                    );
                                break;
                                }
                            case "insertBefore":
                            case "appendChild":
                            case "removeChild":
                                {
                                    MethodInfo method;
                                    if (args.Length == 2)
                                        method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(CHtmlElement), typeof(CHtmlElement) });
                                    else
                                        method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(CHtmlElement) });
                                    var parameters = method.GetParameters();
                                    var callArgs = new Expression[parameters.Length];
                                    for (int i = 0; i < parameters.Length; i++)
                                    {
                                        callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                                    }
                                    return new DynamicMetaObject(
                                        Expression.Call(Expression.Constant(_celement), method, callArgs),
                                        BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                    );
                                }
                            case "getElementById":
                            case "getElementsByClassName":
                            case "getElementsByTagNameNS":
                            case "getElementsByTagName":
                            case "getAttribute":
                            case "createElement":
                                {
                                    MethodInfo methodgetgetElements = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(string) });
                                    var parametersGetElementByTagName = methodgetgetElements.GetParameters();
                                    var callArgsGetElementByTagName = new Expression[parametersGetElementByTagName.Length];
                                    for (int i = 0; i < parametersGetElementByTagName.Length; i++)
                                    {
                                        callArgsGetElementByTagName[i] = Expression.Convert(args[i].Expression, parametersGetElementByTagName[i].ParameterType);
                                    }
                                    return new DynamicMetaObject(
                                        Expression.Call(Expression.Constant(_celement), methodgetgetElements, callArgsGetElementByTagName),
                                        BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                    );
                                }
                            case "setAttribute":
                                {
                                    if (args == null)
                                        break;
                                    MethodInfo method = null;
                                    if (args.Length >= 3)
                                        method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(string), typeof(object), typeof(object) });
                                    else if (args.Length == 2)
                                        method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(string), typeof(object) });
                                    else if (args.Length == 1 || args.Length == 0)
                                        throw new NotImplementedException("Parameter is not supported");
                                    var parameters = method.GetParameters();
                                    var callArgs = new Expression[parameters.Length];
                                    for (int i = 0; i < parameters.Length; i++)
                                    {
                                        callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                                    }
                                    return new DynamicMetaObject(
                                        Expression.Call(Expression.Constant(_celement), method, callArgs),
                                        BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                    );
                                }
                            case "setAttributeNode":
                            case "setAttributeNodeNS":
                            case "setAttributeNS":
                                {
                                    throw new NotImplementedException();
                                }
                            case "cloneNode":
                                {
                                    MethodInfo method;
                                    if (args.Length >= 1)
                                        method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(object) });
                                    else
                                        method = GetCachedMethod(_celement.GetType(), binder.Name, Type.EmptyTypes);
                                    var parameters = method.GetParameters();
                                    var callArgs = new Expression[parameters.Length];
                                    for (int i = 0; i < parameters.Length; i++)
                                    {
                                        callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                                    }
                                    return new DynamicMetaObject(
                                        Expression.Call(Expression.Constant(_celement), method, callArgs),
                                        BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                    );
                                }
                            case "getContext":
                                {
                                    if (args.Length >= 1)
                                    {
                                        MethodInfo method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(object[]) });
                                        if (method != null)
                                        {
                                            var arrayExpr = Expression.NewArrayInit(
                                                typeof(object),
                                                args.Select(a => Expression.Convert(a.Expression, typeof(object)))
                                            );
                                            return new DynamicMetaObject(
                                                Expression.Call(Expression.Constant(_celement), method, arrayExpr),
                                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                            );
                                        }
                                    }
                                    else
                                    {
                                        throw new NotImplementedException("getContext needs two parama");
                                    }
                                    break;
                                }
                            case "addEventListener":
                                {
                                    if (args.Length >= 1)
                                    {
                                        MethodInfo method = GetCachedMethod(_celement.GetType(), binder.Name, new Type[] { typeof(string), typeof(object) });
                                        var parameters = method.GetParameters();
                                        var callArgs = new Expression[parameters.Length];
                                        for (int i = 0; i < parameters.Length; i++)
                                        {
                                            callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                                        }
                                        return new DynamicMetaObject(
                                            Expression.Call(Expression.Constant(_celement), method, callArgs),
                                            BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                        );
                                    }
                                    else
                                    {
                                        throw new NotImplementedException("addEventLinser needs two parama");

                                    }
                                    break;
                                   
                                }
                        }
                        
                        }
                        break; // Ensure the case block ends properly
                    

                case CHtmlXMLHttpRequest xhr:
                    {
                        var methodInfo = typeof(CHtmlXMLHttpRequest).GetMethod(binder.Name);
                        if (methodInfo != null)
                        {
                            var parameters = methodInfo.GetParameters();
                            if (parameters.Length == 1 && parameters[0].ParameterType == typeof(object[]))
                            {
                                var arrayExpr = Expression.NewArrayInit(
                                    typeof(object),
                                    args.Select(a => Expression.Convert(a.Expression, typeof(object)))
                                );
                                return new DynamicMetaObject(
                                    Expression.Call(Expression.Constant(xhr), methodInfo, arrayExpr),
                                    BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                                );
                            }

                            var callArgs = new Expression[parameters.Length];
                            for (int i = 0; i < parameters.Length; i++)
                            {
                                callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                            }
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(xhr), methodInfo, callArgs),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        break; // Ensure the case block ends properly

                    }
                case CHtmlWorkerWindow _workerWindow:
                    {
                        var methodInfo = typeof(CHtmlWorkerWindow).GetMethod(binder.Name);
                        if (methodInfo != null)
                        {
                            var parameters = methodInfo.GetParameters();
                            var callArgs = new Expression[parameters.Length];
                            for (int i = 0; i < parameters.Length; i++)
                            {
                                callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                            }
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(_workerWindow), methodInfo, callArgs),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        break; // Ensure the case block ends properly
                    }
                case CHtmlCanvasContext2D cHtmlCanvasContext2D:
                    {
                        var methodInfo = GetCachedMethod(typeof(CHtmlCanvasContext2D), binder.Name, args.Select(a => a.LimitType).ToArray());
                        if (methodInfo != null)
                        {
                            var parameters = methodInfo.GetParameters();
                            var callArgs = new Expression[parameters.Length];
                            for (int i = 0; i < parameters.Length; i++)
                            {
                                callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                            }
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(cHtmlCanvasContext2D), methodInfo, callArgs),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        break; // Ensure the case block ends properly
                    }
                case CHtmlSharedWorkerWindow _sharedWorkerWindow:
                    {
                        var methodInfo = typeof(CHtmlSharedWorkerWindow).GetMethod(binder.Name);
                        if (methodInfo != null)
                        {
                            var parameters = methodInfo.GetParameters();
                            var callArgs = new Expression[parameters.Length];
                            for (int i = 0; i < parameters.Length; i++)
                            {
                                callArgs[i] = Expression.Convert(args[i].Expression, parameters[i].ParameterType);
                            }
                            return new DynamicMetaObject(
                                Expression.Call(Expression.Constant(_sharedWorkerWindow), methodInfo, callArgs),
                                BindingRestrictions.GetTypeRestriction(this.Expression, this.LimitType)
                            );
                        }
                        break; // Ensure the case block ends properly
                    }
                case CHtmlFontFace _fontface:

                    { 
                        if(commonLog.LoggingEnabled &&  commonLog.LogLevel >= 8)
                        {
                            commonLog.LogEntry("Bind to fontface is requred");
                        }
                    }
                    break;
            }

            return base.BindInvokeMember(binder, args);
        }

