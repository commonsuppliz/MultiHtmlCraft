        private static double getTextAreaColsRowsWith(CHtmlElement __element, ushort __type, System.Drawing.Font __Font)
        {
            switch (__type)
            {
                case 1:
                    if (__element.___attributes.ContainsKey("rows"))
                    {
                        double intRows = 0;
                        try
                        {

                            string rowNumStr = commonHTML.GetElementAttributeInString(__element, "rows");

                            double.TryParse(rowNumStr, out intRows);
                            if (__Font != null)
                            {
                                intRows = ((float)(intRows * __Font.Height) * 0.7F);
                                return intRows;
                            }
                        }
                        catch { }


                    }

                    break;
                case 2:
                    if (__element.___attributes.ContainsKey("cols"))
                    {

                        double intCols = 0;
                        try
                        {
                            string colNumStr = commonHTML.GetElementAttributeInString(__element, "cols");
                            double.TryParse(colNumStr, out intCols);
                            if (commonHTML.fontOneCharacterWidth > 0)
                            {
                                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5)
                                {
                                    commonLog.LogEntry("Measuresing occur...");
                                }
                                //intCols = (int)(0.42F * (float)intCols * this.___HtmlGraphics.Graphic.MeasureString("W", this.___HtmlGraphics.FontSpec).Width);
                                if (commonHTML.fontOneCharacterWidth > 0)
                                {
                                    intCols = (0.42F * (float)intCols * commonHTML.fontOneCharacterWidth);
                                }
                                return intCols;
                            }
                        }
                        catch { }
                    }
                    break;
            }
            return 0;
        }
        private static void ___populateItemCollections(System.Windows.Forms.ListBox.ObjectCollection ___listCollection, System.Windows.Forms.ComboBox.ObjectCollection ___comboCollection, CHtmlCollection ___list, CHtmlElement ___ownerElement, System.Windows.Forms.Control ___ownerControl)
        {
            bool ___isMultipleSpecifed = false;
            if (___ownerElement != null)
            {
                CHtmlAttribute attrMultiple = null;
                if (___ownerElement.___attributes.TryGetValue("multiple", out attrMultiple))
                {
                    if (attrMultiple != null)
                    {
                        ___isMultipleSpecifed = commonHTML.isCHtmlAttributeValueTreatedAsTrue(attrMultiple);
                        if (___ownerControl is ListBox)
                        {
                            ListBox __ownerList = ___ownerControl as ListBox;
                            __ownerList.SelectionMode = SelectionMode.MultiExtended;
                        }
                    }

                }
            }
            int itemCount = ___list.Count;
            if (itemCount > 0)
            {
                List<int> __SelectedIndexList = new List<int>();
                for (int pos = 0; pos < itemCount; pos++)
                {
                    CHtmlElement __childElement = ___list[pos] as CHtmlElement;
                    if (__childElement != null)
                    {
                        switch (__childElement.___elementTagType)
                        {
                            case CHtmlElementType.OPTION:
                                ___createOptionItems(__childElement, ___listCollection, ___comboCollection, ___list, ___ownerElement, ___ownerControl, __SelectedIndexList);
                                break;
                            case CHtmlElementType.OPTGROUP:
                                // Means We have to look down one level.
                                int ___nextItemCount = __childElement.___childNodes.Count;
                                for (int n = 0; n < ___nextItemCount; n++)
                                {
                                    CHtmlElement __optGroupChildrenElement = __childElement.___childNodes[n] as CHtmlElement;
                                    if (__optGroupChildrenElement != null)
                                    {
                                        if (__optGroupChildrenElement.___elementTagType == CHtmlElementType.OPTION)
                                        {
                                            ___createOptionItems(__optGroupChildrenElement, ___listCollection, ___comboCollection, ___list, ___ownerElement, ___ownerControl, __SelectedIndexList);
                                        }
                                    }
                                }
                                break;
                        }


                    }
                }

                if (__SelectedIndexList.Count > 0)
                {

                    if (___isMultipleSpecifed == true && __SelectedIndexList.Count > 1)
                    {
                        if (___ownerControl is ComboBox)
                        {
                            ComboBox cmb = ___ownerControl as ComboBox;
                            cmb.SelectedIndex = __SelectedIndexList[0]; // combo has does not allow multiple selection.
                        }
                        else if (___ownerControl is ListBox)
                        {
                            // this has been selected at creation time
                        }
                    }
                    else
                    {
                        if (___ownerControl is ComboBox)
                        {
                            ComboBox cmb = ___ownerControl as ComboBox;
                            cmb.SelectedIndex = __SelectedIndexList[0];
                        }
                        else if (___ownerControl is ListBox)
                        {
                            ListBox lb = ___ownerControl as ListBox;
                            lb.SelectedIndex = __SelectedIndexList[0];
                        }
                    }
                }
                else
                {
                    if (___ownerControl is ComboBox)
                    {
                        ComboBox cmb = ___ownerControl as ComboBox;
                        if (cmb.Items.Count > 0)
                        {
                            cmb.SelectedIndex = 0;
                        }
                    }
                    else if (___ownerControl is ListBox)
                    {
                        ListBox lb = ___ownerControl as ListBox;
                        if (lb.Items.Count > 0)
                        {
                            lb.SelectedIndex = 0;
                        }
                    }
                }
            }

        }
        public static void ___createOptionItems(CHtmlElement __childElement, System.Windows.Forms.ListBox.ObjectCollection ___listCollection, System.Windows.Forms.ComboBox.ObjectCollection ___comboCollection, CHtmlCollection ___list, CHtmlElement? ___ownerElement, System.Windows.Forms.Control ___ownerControl, List<int> __SelectedIndexList)
        {

            bool ___isOptionSelected = false;
            CHtmlAttribute ___attrSelected = null;
            if (__childElement.___attributes.TryGetValue("selected", out ___attrSelected))
            {
                if (___attrSelected != null)
                {
                    if (commonHTML.isCHtmlAttributeValueTreatedAsTrue(___attrSelected) == true)
                    {
                        ___isOptionSelected = true;
                        if (___comboCollection != null)
                        {
                            __SelectedIndexList.Add(___comboCollection.Count);
                        }
                        else if (___listCollection != null)
                        {
                            __SelectedIndexList.Add(___listCollection.Count);
                        }
                    }
                }
            }

            string ___strText = commonHTML.GetElementInnerText(__childElement);
            if (___comboCollection != null)
            {
                ___comboCollection.Add(___strText);
            }
            else if (___listCollection != null)
            {
                ___listCollection.Add(___strText);
                if (___isOptionSelected == true)
                {
                    ListBox __ownerList = ___ownerControl as ListBox;
                    __ownerList.SetSelected(___listCollection.Count - 1, true);
                }
            }
            return;
        }
