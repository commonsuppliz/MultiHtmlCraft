        private static string ___getCharsetFromContentType(string contentType)
        {
            if (string.IsNullOrEmpty(contentType)) return null;
            var idx = contentType.IndexOf("charset", StringComparison.OrdinalIgnoreCase);
            if (idx < 0) return null;
            var part = contentType.Substring(idx);
            var eq = part.IndexOf('=');
            if (eq < 0) return null;
            var val = part.Substring(eq + 1).Trim().Trim('\'','"');
            var semi = val.IndexOf(';');
            if (semi >= 0) val = val.Substring(0, semi);
            return val.Trim();
        }
