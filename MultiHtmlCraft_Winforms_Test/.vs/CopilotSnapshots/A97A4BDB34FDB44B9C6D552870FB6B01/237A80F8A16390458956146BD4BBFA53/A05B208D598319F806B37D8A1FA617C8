            if (bytes != null && bytes.Length >= 2)
            {
                if (bytes[0] == 0xFE && bytes[1] == 0xFF) { bomSkip = 2; return Encoding.BigEndianUnicode; }
                if (bytes[0] == 0xFF && bytes[1] == 0xFE) { bomSkip = 2; return Encoding.Unicode; }
