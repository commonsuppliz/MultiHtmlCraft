        internal void ___resetWindowTimerInterval(int __StartupMilliseconds, int ___interval)
        {
            if (this.___multiHtmlCraftWindowTimer != null)
            {

                try
                {
                    if (___interval < 25)
                    {
                        ___interval = 25;
                    }
                    this.___multiHtmlCraftWindowTimer.Change(__StartupMilliseconds, ___interval);
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 30)
                    {
                        commonLog.LogEntry("Reset DocumentTimerInterval({0}, {1})", __StartupMilliseconds, ___interval);
                    }
                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 7)
                    {
                        commonLog.LogEntry("ChangeDocumentTimerInterval Error : {0}. but it is ok.", ex.Message);
                    }

                }

            }
        }
        internal void startMultiHtmlCraftWindowTimer(int _minInterval, int _maxInterval)
        {
            ___currentMaxTimerInterval = _maxInterval;
            ___currentMinTimerInterval = _minInterval;
            if (this.___multiHtmlCraftWindowTimer == null)
            {
                try
                {

                    if (System.Threading.Monitor.TryEnter(this.___multiHtmlCraftWindowTimerLockingObject) == true)
                    {


                            System.Threading.TimerCallback tb = new System.Threading.TimerCallback(this.MultiversalTimer_Elapsed);
                            this.___multiHtmlCraftWindowTimer = new System.Threading.Timer(tb);
                            this.___multiHtmlCraftWindowTimer.Change(_maxInterval, _minInterval);
                    }
                }
                catch (Exception ex)
                {
                    if (commonLog.LoggingEnabled && commonLog.LogLevel >= 10)
                    {
                        commonLog.LogEntry("startMultiHtmlCraftWindowTimer() Exception. " + ex.Message);
                    }
                }
                finally
                {
                    System.Threading.Monitor.Exit(this.___multiHtmlCraftWindowTimerLockingObject);
                }

            }
        }



