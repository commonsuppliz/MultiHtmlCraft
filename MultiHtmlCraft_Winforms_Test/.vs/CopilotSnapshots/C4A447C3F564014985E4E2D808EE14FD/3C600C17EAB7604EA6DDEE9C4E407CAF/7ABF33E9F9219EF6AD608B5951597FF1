                    _v8Engine.AddHostObject("console", _consoleInstance);
                }
            }
            
            // Always ensure a console object exists to avoid "console.log is not a function" errors
            // This creates a safe fallback that will be replaced when setDcoument is called
            _v8Engine.Execute(@"
                if (typeof console === 'undefined' || console === null) {
                    var console = {
                        log: function() { },
                        warn: function() { },
                        error: function() { },
                        debug: function() { },
                        info: function() { },
                        trace: function() { },
                        dir: function() { },
                        time: function() { },
                        timeEnd: function() { },
                        assert: function() { },
                        count: function() { },
                        group: function() { },
                        groupEnd: function() { },
