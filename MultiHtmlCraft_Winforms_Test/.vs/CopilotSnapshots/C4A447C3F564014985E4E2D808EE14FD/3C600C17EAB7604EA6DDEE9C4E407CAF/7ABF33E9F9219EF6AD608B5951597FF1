        public void setDcoument(ICHtmlDocumentInterface document)
        {
            if (_isInitCompleted)
            {
                //_v8Engine.Global.SetProperty("document", document);
                _v8Engine.AddHostObject("document", document);

               // _v8Engine.AddHostObject("window.document", document);
                _v8Engine.AddHostObject("document.parentWindow", this._multiversalWindow);
                _v8Engine.AddHostObject("document.parent", this._multiversalWindow);
                _v8Engine.AddHostObject("document.parentWindow.document", document);
                _v8Engine.AddHostObject("document.parent.document", document);
                _v8Engine.AddHostObject("document.parentWindow.parent", this._multiversalWindow);
                _v8Engine.AddHostObject("document.parent.parentWindow", this._multiversalWindow);
                if (document is ICHtmlDocumentInterface)
                {
                    this._v8Engine.AddHostObject("location", ((ICHtmlDocumentInterface)document).location);
             
                }
                
                // Register console object from window - ensure it's always registered
                if (_multiversalWindow != null)
                {
                    _consoleInstance = _multiversalWindow.console;
                    if (_consoleInstance != null)
                    {
                        _v8Engine.AddHostObject("console", _consoleInstance);
                        // Also ensure console is accessible via window.console
                        _v8Engine.Execute(@"
                            if (typeof window !== 'undefined') {
                                window.console = console;
                            }
                            if (typeof self !== 'undefined') {
                                self.console = console;
                            }
                            if (typeof globalThis !== 'undefined') {
                                globalThis.console = console;
                            }
                        ");
                    }
                }
                
                // Register document methods directly as callable functions to ensure JavaScript can call them
                // This is necessary because ClearScript's dynamic binding doesn't always work correctly
                // with IDynamicMetaObjectProvider implementations
                // Use dynamic to call methods that are not in the interface but exist on the concrete class
                dynamic dynDoc = document;
                _v8Engine.AddHostObject("__doc_createElement", new Func<string, object>((tagName) =>
                {
                    return dynDoc.createElement(tagName);
                }));
                _v8Engine.AddHostObject("__doc_getElementById", new Func<string, object>((id) =>
                {
                    return dynDoc.getElementById(id);
                }));
                _v8Engine.AddHostObject("__doc_getElementsByTagName", new Func<string, object>((tagName) =>
                {
                    return dynDoc.getElementsByTagName(tagName);
                }));
                _v8Engine.AddHostObject("__doc_getElementsByClassName", new Func<string, object>((className) =>
                {
                    return dynDoc.getElementsByClassName(className);
                }));
                _v8Engine.AddHostObject("__doc_querySelector", new Func<string, object>((selector) =>
                {
                    return dynDoc.querySelector(selector);
                }));
                _v8Engine.AddHostObject("__doc_querySelectorAll", new Func<string, object>((selector) =>
                {
                    return dynDoc.querySelectorAll(selector);
                }));
                _v8Engine.AddHostObject("__doc_createEvent", new Func<string, object>((eventType) =>
                {
                    return dynDoc.createEvent(eventType);
                }));
                _v8Engine.AddHostObject("__doc_createTextNode", new Func<object, object>((text) =>
                {
                    return dynDoc.createTextNode(text);
                }));
                _v8Engine.AddHostObject("__doc_addEventListener", new Action<string, object>((eventName, handler) =>
                {
                    dynDoc.addEventListener(eventName, handler, null);
                }));
                _v8Engine.AddHostObject("__doc_addEventListener3", new Action<string, object, object>((eventName, handler, options) =>
                {
                    dynDoc.addEventListener(eventName, handler, options);
                }));
                _v8Engine.AddHostObject("__doc_removeEventListener", new Action<string, object>((eventName, handler) =>
                {
                    dynDoc.removeEventListener(eventName, handler, null);
                }));
                _v8Engine.AddHostObject("__doc_removeEventListener3", new Action<string, object, object>((eventName, handler, options) =>
                {
                    dynDoc.removeEventListener(eventName, handler, options);
                }));

                // Override document methods with the direct callable functions
                _v8Engine.Execute(@"
                    (function() {
                        var doc = document;
                        
                        // Override createElement
                        doc.createElement = function(tagName) {
                            return __doc_createElement(tagName);
                        };
                        
                        // Override getElementById
                        doc.getElementById = function(id) {
                            return __doc_getElementById(id);
                        };
                        
                        // Override getElementsByTagName
                        doc.getElementsByTagName = function(tagName) {
                            return __doc_getElementsByTagName(tagName);
                        };
                        
                        // Override getElementsByClassName
                        doc.getElementsByClassName = function(className) {
                            return __doc_getElementsByClassName(className);
                        };
                        
                        // Override querySelector
                        doc.querySelector = function(selector) {
                            return __doc_querySelector(selector);
                        };
                        
                        // Override querySelectorAll
                        doc.querySelectorAll = function(selector) {
                            return __doc_querySelectorAll(selector);
                        };
                        
                        // Override createEvent
                        doc.createEvent = function(eventType) {
                            return __doc_createEvent(eventType);
                        };
                        
                        // Override createTextNode
                        doc.createTextNode = function(text) {
                            return __doc_createTextNode(text);
                        };
                        
                        // Override addEventListener
                        doc.addEventListener = function(eventName, handler, options) {
                            if (arguments.length >= 3) {
                                __doc_addEventListener3(eventName, handler, options);
                            } else {
                                __doc_addEventListener(eventName, handler);
                            }
                        };
                        
                        // Override removeEventListener
                        doc.removeEventListener = function(eventName, handler, options) {
                            if (arguments.length >= 3) {
                                __doc_removeEventListener3(eventName, handler, options);
                            } else {
                                __doc_removeEventListener(eventName, handler);
                            }
                        };
                        
                        // Also set on window.document if window exists
                        if (typeof window !== 'undefined') {
                            window.document = doc;
                        }
                    })();
                ");
                // Fix for CS1026: Added the missing closing parenthesis ')' at the end of the line.
                // Fix for CS0123: Corrected the usage of the `createElement` method to match the expected delegate signature.

                // this._v8Engine.AddHostObject("document.createElement", new Func<object, object, ICHtmlElementInterface>((p1, p2) => document.createElement(p1, p2)));
                // this._v8Engine.AddHostObject("createElement", new Func<ICHtmlElementInterface>(document.createElement);

            }
            _document = document as ICHtmlDocumentInterface;
        }

