        // Helper for BindInvokeMember to call element.getContext and return proxy when canvas returned
        private static object? InvokeGetContext(CHtmlElement element, object[] args)
        {
            try
            {
                var res = element.getContext(args);
                if (res is CHtmlCanvasContext2D canvas) return canvas.GetClearScriptHostProxy();
                return res;
            }
            catch (Exception ex)
            {
                try { if (commonLog.LoggingEnabled && commonLog.LogLevel >= 5) commonLog.LogEntry("InvokeGetContext error: {0}\n{1}", ex.Message, ex.ToString()); } catch { }
                return null;
            }
        }
