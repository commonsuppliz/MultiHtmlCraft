        public Rectangle GetPaintRectScrollbar()
        {
            if (this.Disposing == true)
                return Rectangle.Empty;
            int ___horizontalBarValue = 0;

            int ___horizontalBarMaximum = 0;
            if (this.horizontalBar != null)
            {
                ___horizontalBarValue = this.horizontalBar.Value;
                ___horizontalBarMaximum = this.horizontalBar.Maximum;
            }
            else
            {
                ___horizontalBarMaximum = this.Width;
            }
            int _verticalBarValue = 0;


            int _verticalMaximum = 0;
            if (this.verticalBar != null)
            {
                _verticalMaximum = this.verticalBar.Maximum;
                _verticalBarValue = this.verticalBar.Value;
            }
            else
            {
                _verticalMaximum = this.Height;
            }

            int _HalfHeight = (int)((double)this.ClientRectangle.Height / (double)2);
            if (_verticalMaximum > this.ClientRectangle.Height && _verticalBarValue > _verticalMaximum - this.ClientRectangle.Height)
            {
                _verticalBarValue = _verticalMaximum - this.ClientRectangle.Height + 20;
            }


            if (___horizontalBarValue < 0)
            {
                if (this.horizontalBar != null)
                {
                    this.horizontalBar.SuspendLayout();
                    this.horizontalBar.Value = 0;
                    this.horizontalBar.ResumeLayout();
                }
            }
            if (_verticalBarValue < 0)
            {
                if (this.verticalBar != null)
                {
                    this.verticalBar.SuspendLayout();
                    this.verticalBar.Value = 0;
                    this.verticalBar.ResumeLayout();
                }
            }
            Rectangle dispRect = new Rectangle(___horizontalBarValue, _verticalBarValue, ___horizontalBarMaximum, _verticalMaximum);
            Rectangle cliRect = this.ClientRectangle;
            Rectangle PaintRect = new Rectangle(Math.Abs(dispRect.X), Math.Abs(dispRect.Y), cliRect.Width, cliRect.Height);
            return PaintRect;
        }

