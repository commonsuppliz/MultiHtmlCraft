        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);
            Graphics gr = e.Graphics;

            var grCon = this.CreateGraphicContainer(e.Graphics);
            // grCon.PaintRectangle = new RectangleF(0, 0, 1000, 800);
            grCon.IsUIThreadPaint = true;
            grCon.Graphic = gr;
            grCon.PaintRectangle = this.GetPaintRectScrollbar();
            if (document != null && document.documentElement != null)
            {


                CHtmlElement documentRootElement = document.documentElement as CHtmlElement;

                if (_documentPaintCount >= int.MaxValue)
                    _documentPaintCount = 0;
                _documentPaintCount++;
                if (commonLog.LoggingEnabled && commonLog.LogLevel >= 15 && _documentPaintCount == 1 && documentRootElement != null)
                {
                    commonUtils.LogElementDOMTree(documentRootElement, "", commonUtils.CJHtmlDOMElementLogModeType.ElementWidthAndHeight);
                }

                document.drawRootElementRecursively(documentRootElement, ref grCon);
            }
        }
        private void updateListView(object sender, EventArgs e)
        {
            ListView? currentListView = null;
            bool isTabContolContainsListView = false;
            int currentTabIndex = tabControl?.SelectedIndex ?? 0;
            if (commonLog.LoggingEnabled && commonLog.LogLevel >= 9)
            {
                commonLog.LogEntry($"Selected Tab Index: {currentTabIndex}");
            }
            if (tabControl != null && tabControl.TabPages.Count > currentTabIndex)
            {
               var selectedTab = tabControl.TabPages[currentTabIndex];
                if (selectedTab.Controls.Count > 0 && selectedTab.Controls[0] is ListView)
                {
                    currentListView = selectedTab.Controls[0] as ListView;
                    isTabContolContainsListView = true;
                }
                else
                {
                    currentListView = new ListView
                    {
                        Dock = DockStyle.Fill,
                        View = View.Details,
                        FullRowSelect = true,
                        GridLines = true,
                        
                    };
                    currentListView.Columns.Add("Name", 180);
                    currentListView.Columns.Add("Value", 100);
                    currentListView.Columns.Add("Description", 200);
                    selectedTab.Controls.Add(currentListView);

                }
            }


            // タブごとのアイテムを生成
            if (!isTabContolContainsListView)
            {
       
                currentListView.SuspendLayout();
      
            
                var listViewItems = new List<ListViewItem>();
                var rand = new Random();

                for (int i = 0; i < 300; i++)
                {

                    ListViewItem item = new ListViewItem($"Item {i + 1}");
                    item.Text = $"Item {rand.Next(100)}";
                    item.SubItems.Add($"Description {rand.Next(100)}");
                    item.SubItems.Add($"Value {rand.Next(1000)}");
                    listViewItems.Add(item);
                }
      
                currentListView.Items.AddRange(listViewItems.ToArray());
                currentListView.ResumeLayout();
            }
     


        }

        protected override void OnClick(EventArgs e)
        {
            base.OnClick(e);
            if (sidePanel == null)
            {
                sidePanel = new Panel();
                sidePanel.Dock = DockStyle.Right;
                sidePanel.Width = this.Width / 4;
                sidePanel.BackColor = System.Drawing.Color.LightGray;

                tabControl = new TabControl();
                tabControl.Dock = DockStyle.Fill;
                tabControl.TabPages.Add("🌳"); // DOM Tree
                tabControl.TabPages.Add("🎨"); // CSS
                tabControl.TabPages.Add("📜"); // Script
                tabControl.TabPages.Add("⬇️"); // Download
                sidePanel.Controls.Add(tabControl);

                // ListViewの追加
                sideListView = new ListView
                {
                    Dock = DockStyle.Fill,
                    View = View.Details,
                    FullRowSelect = true,
                    GridLines = true
                };
                sideListView.Columns.Add("Name", 180);
                sideListView.Columns.Add("Value", 100);
                sideListView.Columns.Add("Description", 200);
                sideListView.SuspendLayout();


                var listViewItems = new List<ListViewItem>();
                var rand = new Random();

                for (int i = 0; i < 300; i++)
                {

                    ListViewItem item = new ListViewItem($"Item {i + 1}");
                    item.Text = $"Item {rand.Next(100)}";
                    item.SubItems.Add($"Description {rand.Next(100)}");
                    item.SubItems.Add($"Value {rand.Next(1000)}");
                    listViewItems.Add(item);
                }

                sideListView.Items.AddRange(listViewItems.ToArray());
                sideListView.ResumeLayout();
                tabControl.TabPages[0].Controls.Add(sideListView);



                tabControl.SelectedIndexChanged += this.updateListView;
                //tabControl.Click += updateListView;

                this.Controls.Add(sidePanel);
                sidePanel.BringToFront();

                // Splitterの追加（sidePanelの左側に配置）
                sideSplitter = new Splitter();
                sideSplitter.Dock = DockStyle.Right;
                sideSplitter.Width = 5;
                sideSplitter.MinExtra = 100;
                sideSplitter.MinSize = 50;
                sideSplitter.BackColor = System.Drawing.Color.LightSlateGray;
                this.Controls.Add(sideSplitter);
                sideSplitter.BringToFront();

                closeButton = new Button();
                closeButton.Text = "❌";
                closeButton.FlatStyle = FlatStyle.Flat;
                closeButton.Width = 32;
                closeButton.Height = tabControl.ItemSize.Height > 0 ? tabControl.ItemSize.Height : 25;
                closeButton.BackColor = this.BackColor;

                this.Controls.Add(closeButton);
                closeButton.BringToFront();
                closeButton.Click += (s, args) =>
                {
                    this.Controls.Remove(closeButton);
                    this.Controls.Remove(sidePanel);
                    if (sideSplitter != null)
                    {
                        this.Controls.Remove(sideSplitter);
                        sideSplitter.Dispose();
                        sideSplitter = null;
                    }
                    sidePanel.Dispose();
                    sidePanel = null;
                    tabControl = null;
                    closeButton = null;
                    sideListView = null;
                    listViewItems = null;
                };
                UpdateCloseButtonLocation();
            }
        }


        private void UpdateCloseButtonLocation()
        {
            if (closeButton != null && closeButton.Parent == this)
            {
                int x = this.ClientSize.Width - closeButton.Width - 4;
                int y = 2;
                closeButton.Location = new System.Drawing.Point(x, y);
                closeButton.BringToFront();
                closeButton.Visible = (sidePanel != null && sidePanel.Visible);
            }
        }

        protected override void OnResize(EventArgs e)
        {
            base.OnResize(e);
            this.SuspendLayout();
            this.horizontalBar.Location = new System.Drawing.Point(0, this.ClientSize.Height - this.horizontalBar.Height);
            this.horizontalBar.Size = new System.Drawing.Size(this.ClientSize.Width - this.verticalBar.Width, this.horizontalBar.Height);

            this.verticalBar.Location = new System.Drawing.Point(this.ClientSize.Width - this.verticalBar.Width, 0);
            this.verticalBar.Size = new System.Drawing.Size(this.verticalBar.Width, this.ClientSize.Height - this.horizontalBar.Height);
            int oldH = horizontalBar.Value;
            if (horizontalBar.Maximum > 0)
                horizontalBar.Value = (oldH == 0) ? 1 : 0;
            horizontalBar.Value = oldH;

            int oldV = verticalBar.Value;
            if (verticalBar.Maximum > 0)
                verticalBar.Value = (oldV == 0) ? 1 : 0;
            verticalBar.Value = oldV;
            if (sidePanel != null)
            {
                // sidePanelの幅はSplitterで調整されるのでここでは何もしない
            }
            this.ResumeLayout(false);
            UpdateCloseButtonLocation();
        }
