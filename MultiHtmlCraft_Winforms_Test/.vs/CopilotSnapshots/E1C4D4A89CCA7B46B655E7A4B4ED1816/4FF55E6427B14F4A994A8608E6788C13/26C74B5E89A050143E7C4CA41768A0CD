using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace MultiHtmlCraft.Core
{
    public class CHtmlFontFace
    {
        // font-family: フォントファミリー名
        public string fontFamily { get; set; }
        // src: フォントファイルのURLやローカルパス
        public string src { get; set; }
        // font-weight: 通常は normal, bold, 100-900 など
        public string fontWeight { get; set; }
        // font-style: normal, italic, oblique など
        public string fontStyle { get; set; }
        // font-stretch: normal, condensed, expanded など
        public string fontStretch { get; set; }
        // unicode-range: 対象となるUnicode範囲
        public string unicodeRange { get; set; }
        // ascent-override, descent-override, line-gap-override なども必要に応じて
        public string ascentOverride { get; set; }
        public string descentOverride { get; set; }
        public string lineGapOverride { get; set; }
        // loaded: フォントがロード済みかどうか
        public bool loaded { get; set; }
        // status: フォントのロード状態（例: unloaded, loading, loaded, error）
        public string status { get; set; }
        // style: 任意の追加スタイル情報
        public string style { get; set; }

        public CHtmlFontFace()
        {
            // デフォルト値を設定
            fontFamily = string.Empty;
            src = string.Empty;
            fontWeight = "normal";
            fontStyle = "normal";
            fontStretch = "normal";
            unicodeRange = string.Empty;
            ascentOverride = string.Empty;
            descentOverride = string.Empty;
            lineGapOverride = string.Empty;
            loaded = false;
            status = "unloaded";
            style = string.Empty;
        }

        // フォントを非同期でロードするメソッド。Promise風にTaskを返す。
        public Task<CHtmlFontFace> load()
        {
            return Task.Run(async () =>
            {
                status = "loading";
                try
                {
                    // フォントファイルの存在チェックやロード処理をここに記述
                    // ここではダミーで遅延を入れる
                    await Task.Delay(100); // 実際はファイルアクセスやネットワークアクセス等
                    loaded = true;
                    status = "loaded";
                }
                catch (Exception)
                {
                    loaded = false;
                    status = "error";
                }
                return this;
            });
        }
    }
}
