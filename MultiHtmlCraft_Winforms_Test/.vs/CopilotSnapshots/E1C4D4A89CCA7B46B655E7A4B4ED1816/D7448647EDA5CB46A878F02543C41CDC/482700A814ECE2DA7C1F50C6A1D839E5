            Expression.Call(
            Expression.Convert(Expression, LimitType),
            typeof(DynamicDictionary).GetMethod("WriteMethodInfo"),
            parameters),
            BindingRestrictions.GetTypeRestriction(Expression, LimitType));
            */
            return methodInfo;
        }
        #endregion
    }
